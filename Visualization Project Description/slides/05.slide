<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        flexDirection: 'column',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
        position: 'relative',
    }}
>
    {/* ── zona A ── */}
    <Box style={{ height: 110, justifyContent: 'flex-start' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#2A2333',
                lineHeight: 1.3,
                fontFamily: 'Trebuchet MS',
            }}
        >
            Eight moments in the school week
        </Text>
        <Box style={{ width: 72, height: 6, background: '#51277C', marginTop: 12 }} />
    </Box>

    {/* ── zona B ── */}
    <Box style={{ height: 530, flexDirection: 'row', gap: 20 }}>
        {/* kolom lebar: delapan skenario */}
        <Box style={{ flex: 60, flexDirection: 'column', gap: 12 }}>
            <Box style={{ flexDirection: 'row', gap: 24 }}>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#c4762a', letterSpacing: 1 }}>
                        S1 · EVERY MORNING
                    </Text>
                    <Text
                        style={{
                            fontSize: 17,
                            fontWeight: 'bold',
                            color: '#2A2333',
                            marginTop: 5,
                            fontFamily: 'Trebuchet MS',
                        }}
                    >
                        Today’s snack
                    </Text>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 6 }}>
                        One screen, with the duty guardian’s WhatsApp link beside the menu.
                    </Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#c4762a', letterSpacing: 1 }}>
                        S2 · SUNDAY EVENING
                    </Text>
                    <Text
                        style={{
                            fontSize: 17,
                            fontWeight: 'bold',
                            color: '#2A2333',
                            marginTop: 5,
                            fontFamily: 'Trebuchet MS',
                        }}
                    >
                        Weekly planning
                    </Text>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 6 }}>
                        Menu and duty roster were read from two places; now one view, Mon–Fri.
                    </Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row', gap: 24 }}>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#c4762a', letterSpacing: 1 }}>
                        S3 · WHEN A CLASS IS ON DUTY
                    </Text>
                    <Text
                        style={{
                            fontSize: 17,
                            fontWeight: 'bold',
                            color: '#2A2333',
                            marginTop: 5,
                            fontFamily: 'Trebuchet MS',
                        }}
                    >
                        Duty rotation
                    </Text>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 6 }}>
                        Duty is a typed relationship, chosen from that class’s own roster.
                    </Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#c4762a', letterSpacing: 1 }}>
                        S4 · WHEN A DATE IS OPEN
                    </Text>
                    <Text
                        style={{
                            fontSize: 17,
                            fontWeight: 'bold',
                            color: '#2A2333',
                            marginTop: 5,
                            fontFamily: 'Trebuchet MS',
                        }}
                    >
                        Claiming a date
                    </Text>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 6 }}>
                        Parents claim it themselves — race-safe at the database level.
                    </Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row', gap: 24 }}>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#c4762a', letterSpacing: 1 }}>
                        S5 · ONCE A MONTH
                    </Text>
                    <Text
                        style={{
                            fontSize: 17,
                            fontWeight: 'bold',
                            color: '#2A2333',
                            marginTop: 5,
                            fontFamily: 'Trebuchet MS',
                        }}
                    >
                        Lock and publish
                    </Text>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 6 }}>
                        A three-state machine replaced “the file was sent or it was not”.
                    </Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#c4762a', letterSpacing: 1 }}>
                        S6 · MONTHLY MEETING
                    </Text>
                    <Text
                        style={{
                            fontSize: 17,
                            fontWeight: 'bold',
                            color: '#2A2333',
                            marginTop: 5,
                            fontFamily: 'Trebuchet MS',
                        }}
                    >
                        Is the duty load fair?
                    </Text>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 6 }}>
                        The report ranks every parent and names those who took none.
                    </Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row', gap: 24 }}>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#c4762a', letterSpacing: 1 }}>
                        S7 · PLANNING NEXT MONTH
                    </Text>
                    <Text
                        style={{
                            fontSize: 17,
                            fontWeight: 'bold',
                            color: '#2A2333',
                            marginTop: 5,
                            fontFamily: 'Trebuchet MS',
                        }}
                    >
                        Menu reuse and history
                    </Text>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 6 }}>
                        A searchable catalog of 43 menus and 85 items, shared by all classes.
                    </Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#c4762a', letterSpacing: 1 }}>
                        S8 · EACH SCHOOL YEAR
                    </Text>
                    <Text
                        style={{
                            fontSize: 17,
                            fontWeight: 'bold',
                            color: '#2A2333',
                            marginTop: 5,
                            fontFamily: 'Trebuchet MS',
                        }}
                    >
                        Account lifecycle
                    </Text>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 6 }}>
                        Excel round-trip: export, edit, import — always through a dry run.
                    </Text>
                </Box>
            </Box>
        </Box>

        {/* kolom sempit: pasangan penentu arsitektur */}
        <Box
            style={{
                flex: 40,
                background: 'linear-gradient(135deg, #51277C 0%, #7A45A8 100%)',
                borderRadius: 10,
                paddingTop: 26,
                paddingBottom: 26,
                paddingLeft: 26,
                paddingRight: 26,
                flexDirection: 'column',
            }}
        >
            <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#AFC440', letterSpacing: 1.4 }}>
                THE PAIR THAT SHAPED IT
            </Text>
            <Text
                style={{
                    fontSize: 24,
                    fontWeight: 'bold',
                    color: '#FFFFFF',
                    lineHeight: 1.3,
                    marginTop: 12,
                    fontFamily: 'Trebuchet MS',
                }}
            >
                S4 + S5, together
            </Text>
            <Box style={{ width: 56, height: 5, background: '#AFC440', marginTop: 16 }} />
            <Text
                style={{
                    fontSize: 16,
                    color: 'rgba(255,255,255,0.88)',
                    lineHeight: 1.6,
                    marginTop: 18,
                }}
            >
                Claiming writes back into a schedule row. Publishing freezes rows. If both could
                write freely, a parent could claim a slot in a month the school had already
                announced.
            </Text>
            <Box style={{ marginTop: 'auto', flexDirection: 'row', gap: 10, alignItems: 'center' }}>
                <Box style={{ width: 6, height: 20, background: '#F3B26C' }} />
                <Text style={{ fontSize: 15, color: '#F3B26C', fontWeight: 'bold' }}>
                    The status machine makes that impossible.
                </Text>
            </Box>
        </Box>
    </Box>

    {/* ── zona C ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            justifyContent: 'space-between',
            alignItems: 'center',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478' }}>
            Pizza Snack Play · Visualization Project Description
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6478' }}>05 / 16</Text>
    </Box>
</Slide>
