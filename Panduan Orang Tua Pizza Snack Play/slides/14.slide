<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
    }}
>
    {/* ── A · blok judul ── */}
    <Box style={{ height: 110, justifyContent: 'center' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#51277C',
                fontFamily: 'Trebuchet MS',
                lineHeight: 1.3,
            }}
        >
            Empat hal yang perlu diingat
        </Text>
        <Box style={{ marginTop: 10, width: 72, height: 6, borderRadius: 3, background: '#51277C' }} />
    </Box>

    {/* ── B · area konten ── */}
    <Box style={{ height: 530 }}>
        <Box style={{ height: 470, flexDirection: 'row', gap: 18 }}>
            {[
                {
                    vb: '0 0 512 512',
                    d: 'M256 0a256 256 0 1 1 0 512A256 256 0 1 1 256 0zM232 120V256c0 8 4 15.5 10.7 20l96 64c11 7.4 25.9 4.4 33.3-6.7s4.4-25.9-6.7-33.3L280 243.2V120c0-13.3-10.7-24-24-24s-24 10.7-24 24z',
                    t: 'Jadwal muncul setelah diumumkan',
                    d: 'Jadwal baru tampil setelah korlas atau admin sekolah mengumumkannya. Kalau hari itu belum muncul, berarti belum diumumkan — bukan hilang.',
                    g: 'Sabar menunggu',
                },
                {
                    vb: '0 0 640 512',
                    d: 'M144 0a80 80 0 1 1 0 160A80 80 0 1 1 144 0zM512 0a80 80 0 1 1 0 160A80 80 0 1 1 512 0zM0 298.7C0 239.8 47.8 192 106.7 192h42.7c15.9 0 31 3.5 44.6 9.7c-1.3 7.2-1.9 14.7-1.9 22.3c0 38.2 16.8 72.5 43.3 96c-.2 0-.4 0-.7 0H21.3C9.6 320 0 310.4 0 298.7zM405.3 320c-.2 0-.4 0-.7 0c26.6-23.5 43.3-57.8 43.3-96c0-7.6-.7-15-1.9-22.3c13.6-6.3 28.7-9.7 44.6-9.7h42.7C592.2 192 640 239.8 640 298.7c0 11.8-9.6 21.3-21.3 21.3H405.3zM224 224a96 96 0 1 1 192 0 96 96 0 1 1 -192 0zM128 485.3C128 411.7 187.7 352 261.3 352H378.7C452.3 352 512 411.7 512 485.3c0 14.7-11.9 26.7-26.7 26.7H154.7c-14.7 0-26.7-11.9-26.7-26.7z',
                    t: 'Satu akun untuk beberapa anak',
                    d: 'Punya dua anak di kelas berbeda tidak perlu akun tambahan. Pilih kelasnya di bagian atas layar, jadwalnya ikut berganti.',
                    g: 'Tidak perlu daftar ulang',
                },
                {
                    vb: '0 0 576 512',
                    d: 'M575.8 255.5c0 18-15 32.1-32 32.1h-32l.7 160.2c0 2.7-.2 5.4-.5 8.1V472c0 22.1-17.9 40-40 40H456c-1.1 0-2.2 0-3.3-.1c-1.4 .1-2.8 .1-4.2 .1H416 392c-22.1 0-40-17.9-40-40V448 384c0-17.7-14.3-32-32-32H256c-17.7 0-32 14.3-32 32v64 24c0 22.1-17.9 40-40 40H160 128.1c-1.5 0-3-.1-4.5-.2c-1.2 .1-2.4 .2-3.6 .2H104c-22.1 0-40-17.9-40-40V360c0-.9 0-1.9 .1-2.8V287.6H32c-18 0-32-14-32-32.1c0-9 3-17 10-24L266.4 8c7-7 15-8 22-8s15 2 21 7L564.8 231.5c8 7 12 15 11 24z',
                    t: 'Ambil tanggal di kelas anak sendiri',
                    d: 'Setiap kelas punya baris jadwalnya sendiri. Mengambil tanggal di kelas lain tidak bisa, dan tanggal di kelas anak tidak tertutup oleh kelas lain.',
                    g: 'Adil per kelas',
                },
                {
                    vb: '0 0 512 512',
                    d: 'M164.9 24.6c-7.7-18.6-28-28.5-47.4-23.2l-88 24C12.1 30.2 0 46 0 64C0 311.4 200.6 512 448 512c18 0 33.8-12.1 38.6-29.5l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-96-40c-16.3-6.8-35.2-2.1-46.3 11.6L304.7 368C234.3 334.7 177.3 277.7 144 207.3L193.3 167c13.7-11.2 18.4-30 11.6-46.3l-40-96z',
                    t: 'Perubahan lewat korlas kelas',
                    d: 'Jadwal yang sudah diumumkan tidak bisa diubah sendiri. Sampaikan ke korlas kelas atau admin sekolah bila ada keperluan mendadak.',
                    g: 'Jangan diubah sendiri',
                },
            ].map((c, idx) => (
                <Box
                    key={idx}
                    style={{
                        flex: 1,
                        height: '100%',
                        background: '#FFFFFF',
                        borderRadius: 16,
                        boxShadow: '0 4px 20px rgba(0,0,0,0.08)',
                        padding: 24,
                        borderTop: '8px solid #AFC440',
                    }}
                >
                    <Box
                        style={{
                            width: 60,
                            height: 60,
                            borderRadius: 30,
                            background: 'rgba(81,39,124,0.10)',
                            justifyContent: 'center',
                            alignItems: 'center',
                        }}
                    >
                        <svg width={30} height={30} viewBox={c.vb} xmlns="http://www.w3.org/2000/svg"><path fill="#51277C" d={c.d} /></svg>
                    </Box>

                    <Text
                        style={{
                            marginTop: 16,
                            fontSize: 23,
                            fontWeight: 'bold',
                            color: '#51277C',
                            fontFamily: 'Trebuchet MS',
                            lineHeight: 1.32,
                        }}
                    >
                        {c.t}
                    </Text>

                    <Box
                        style={{
                            marginTop: 12,
                            width: 44,
                            height: 3,
                            borderRadius: 2,
                            background: '#AFC440',
                        }}
                    />

                    <Text
                        style={{
                            marginTop: 12,
                            fontSize: 18,
                            color: '#6B6478',
                            fontFamily: 'Verdana',
                            lineHeight: 1.55,
                        }}
                    >
                        {c.d}
                    </Text>

                    <Box style={{ marginTop: 'auto' }}>
                        <Text
                            style={{
                                fontSize: 16,
                                color: '#51277C',
                                fontFamily: 'Verdana',
                                fontWeight: 'bold',
                            }}
                        >
                            {c.g}
                        </Text>
                    </Box>
                </Box>
            ))}
        </Box>

        {/* simpulan */}
        <Box
            style={{
                marginTop: 14,
                height: 46,
                background: '#51277C',
                borderRadius: 14,
                justifyContent: 'center',
                alignItems: 'center',
            }}
        >
            <Text
                style={{
                    fontSize: 19,
                    color: '#FFFFFF',
                    fontFamily: 'Verdana',
                    fontWeight: 'bold',
                }}
            >
                Intinya: satu akun, satu aplikasi, dan semua perubahan disampaikan lewat korlas kelas.
            </Text>
        </Box>
    </Box>

    {/* ── C · bilah kaki ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>
            Pizza Snack Play · Panduan Orang Tua
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>14 / 15</Text>
    </Box>
</Slide>
