<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
    }}
>
    {/* ── A · blok judul ── */}
    <Box style={{ height: 110, justifyContent: 'center' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#51277C',
                fontFamily: 'Trebuchet MS',
                lineHeight: 1.3,
            }}
        >
            Kelola akun orang tua sekaligus
        </Text>
        <Box style={{ marginTop: 10, width: 72, height: 6, borderRadius: 3, background: '#51277C' }} />
    </Box>

    {/* ── B · area konten ── */}
    <Box style={{ height: 530, flexDirection: 'row', gap: 30 }}>
        {/* kiri 55% · alur berkas → pratinjau → daftar */}
        <Box
            style={{
                width: '55%',
                height: '100%',
                background: 'rgba(81,39,124,0.06)',
                borderRadius: 20,
                justifyContent: 'center',
                alignItems: 'center',
            }}
        >
            <svg width={520} height={430} viewBox='0 0 520 430'>
                {/* langkah 1 · berkas daftar akun */}
                <rect x='40' y='4' width='440' height='140' rx='14' fill='#FFFFFF' stroke='#E6DFD2' strokeWidth='2' />
                <rect x='40' y='4' width='440' height='36' rx='14' fill='#51277C' />
                <rect x='40' y='24' width='440' height='16' fill='#51277C' />
                <text x='62' y='29' fontFamily='Verdana' fontSize='13' fill='#FFFFFF'>
                    Nama orang tua
                </text>
                <text x='238' y='29' fontFamily='Verdana' fontSize='13' fill='#FFFFFF'>
                    Username
                </text>
                <text x='368' y='29' fontFamily='Verdana' fontSize='13' fill='#FFFFFF'>
                    Anak
                </text>

                <rect x='62' y='56' width='150' height='10' rx='5' fill='#DED7CB' />
                <rect x='238' y='56' width='110' height='10' rx='5' fill='#EDE8DF' />
                <rect x='368' y='56' width='90' height='10' rx='5' fill='#EDE8DF' />

                <rect x='62' y='80' width='150' height='10' rx='5' fill='#DED7CB' />
                <rect x='238' y='80' width='110' height='10' rx='5' fill='#EDE8DF' />
                <rect x='368' y='80' width='90' height='10' rx='5' fill='#EDE8DF' />

                <rect x='62' y='104' width='150' height='10' rx='5' fill='#DED7CB' />
                <rect x='238' y='104' width='110' height='10' rx='5' fill='#EDE8DF' />
                <rect x='368' y='104' width='90' height='10' rx='5' fill='#EDE8DF' />

                <rect x='62' y='128' width='150' height='10' rx='5' fill='#AFC440' />
                <rect x='238' y='128' width='110' height='10' rx='5' fill='#EDE8DF' />
                <rect x='368' y='128' width='90' height='10' rx='5' fill='#EDE8DF' />

                {/* panah */}
                <path d='M260 148v20' stroke='#AFC440' strokeWidth='5' strokeLinecap='round' />
                <path d='M250 166l10 12 10-12' fill='none' stroke='#AFC440' strokeWidth='5' strokeLinecap='round' strokeLinejoin='round' />

                {/* langkah 2 · pratinjau */}
                <rect x='40' y='190' width='440' height='132' rx='14' fill='#FFFFFF' stroke='#E6DFD2' strokeWidth='2' />
                <text x='64' y='222' fontFamily='Trebuchet MS' fontSize='20' fontWeight='bold' fill='#51277C'>
                    Pratinjau
                </text>
                <rect x='64' y='236' width='128' height='34' rx='10' fill='rgba(175,196,64,0.25)' />
                <text x='128' y='258' fontFamily='Verdana' fontSize='14' fill='#3F4718' textAnchor='middle'>
                    Dibuat 2
                </text>
                <rect x='200' y='236' width='152' height='34' rx='10' fill='rgba(81,39,124,0.12)' />
                <text x='276' y='258' fontFamily='Verdana' fontSize='14' fill='#51277C' textAnchor='middle'>
                    Diperbarui 34
                </text>
                <rect x='360' y='236' width='104' height='34' rx='10' fill='rgba(107,100,120,0.16)' />
                <text x='412' y='258' fontFamily='Verdana' fontSize='14' fill='#6B6478' textAnchor='middle'>
                    Dilewati 1
                </text>
                <rect x='320' y='282' width='136' height='30' rx='15' fill='#51277C' />
                <text x='388' y='302' fontFamily='Verdana' fontSize='14' fontWeight='bold' fill='#FFFFFF' textAnchor='middle'>
                    Terapkan
                </text>

                {/* panah */}
                <path d='M260 326v18' stroke='#AFC440' strokeWidth='5' strokeLinecap='round' />
                <path d='M250 342l10 12 10-12' fill='none' stroke='#AFC440' strokeWidth='5' strokeLinecap='round' strokeLinejoin='round' />

                {/* langkah 3 · hasil */}
                <rect x='40' y='366' width='440' height='56' rx='14' fill='#51277C' />
                <circle cx='76' cy='394' r='17' fill='#AFC440' />
                <path d='M68 394l6 6 11-12' fill='none' stroke='#3F4718' strokeWidth='4' strokeLinecap='round' strokeLinejoin='round' />
                <text x='106' y='390' fontFamily='Trebuchet MS' fontSize='19' fontWeight='bold' fill='#FFFFFF'>
                    Daftar akun diperbarui
                </text>
                <text x='106' y='410' fontFamily='Verdana' fontSize='13' fill='#EFEAE1'>
                    Langsung bisa dipakai masuk oleh orang tua
                </text>
            </svg>
        </Box>

        {/* kanan 45% · tiga keterangan */}
        <Box style={{ width: '45%', height: '100%', justifyContent: 'space-between' }}>
            {[
                {
                    t: 'Satu berkas, dua arah',
                    d: 'Unduh daftar akun sebagai Excel, sunting sebanyak yang perlu, lalu unggah kembali berkas yang sama.',
                    g: 'Khusus admin',
                },
                {
                    t: 'Ada ditimpa, baru ditambah',
                    d: 'Username yang sudah terdaftar diperbarui; yang belum ada dibuatkan akun baru. Sel kosong tidak mengubah apa pun.',
                    g: 'Dikunci pada username',
                },
                {
                    t: 'Pratinjau sebelum berubah',
                    d: 'Layar menunjukkan lebih dulu berapa akun dibuat, diperbarui, dan dilewati. Belum ada yang tersimpan.',
                    g: 'Aman diulang',
                },
            ].map((it, i) => (
                <Box
                    key={i}
                    style={{
                        height: 166,
                        background: '#FFFFFF',
                        borderRadius: 16,
                        boxShadow: '0 4px 20px rgba(0,0,0,0.08)',
                        padding: 22,
                        borderLeft: i === 2 ? '8px solid #F3B26C' : '8px solid #AFC440',
                    }}
                >
                    <Text
                        style={{
                            fontSize: 24,
                            fontWeight: 'bold',
                            color: '#51277C',
                            fontFamily: 'Trebuchet MS',
                            lineHeight: 1.3,
                        }}
                    >
                        {it.t}
                    </Text>
                    <Text
                        style={{
                            marginTop: 10,
                            fontSize: 17,
                            color: '#6B6478',
                            fontFamily: 'Verdana',
                            lineHeight: 1.5,
                        }}
                    >
                        {it.d}
                    </Text>
                    <Box style={{ marginTop: 'auto' }}>
                        <Text
                            style={{
                                fontSize: 16,
                                color: '#51277C',
                                fontFamily: 'Verdana',
                                fontWeight: 'bold',
                            }}
                        >
                            {it.g}
                        </Text>
                    </Box>
                </Box>
            ))}
        </Box>
    </Box>

    {/* ── C · bilah kaki ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>
            Pizza Snack Play · Panduan Korlas &amp; Admin
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>07 / 17</Text>
    </Box>
</Slide>
