<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        flexDirection: 'column',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
        position: 'relative',
    }}
>
    {/* ── zona A ── */}
    <Box style={{ height: 110, justifyContent: 'flex-start' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#2A2333',
                lineHeight: 1.3,
                fontFamily: 'Trebuchet MS',
            }}
        >
            Impact, before and after
        </Text>
        <Box style={{ width: 72, height: 6, background: '#51277C', marginTop: 12 }} />
    </Box>

    {/* ── zona B ── */}
    <Box style={{ height: 530, flexDirection: 'row', gap: 24 }}>
        {/* kiri: pasangan before/after */}
        <Box style={{ flex: 60, flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'row', paddingBottom: 10 }}>
                <Box style={{ width: 150 }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#6B6478', letterSpacing: 0.8 }}>
                        IMPACT
                    </Text>
                </Box>
                <Box style={{ flex: 1 }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#6B6478', letterSpacing: 0.8 }}>
                        BEFORE
                    </Text>
                </Box>
                <Box style={{ flex: 1 }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#576420', letterSpacing: 0.8 }}>
                        AFTER
                    </Text>
                </Box>
            </Box>
            <Box style={{ height: 1, background: 'rgba(81,39,124,0.22)' }} />

            <Box style={{ flexDirection: 'row', paddingTop: 16, paddingBottom: 16 }}>
                <Box style={{ width: 150, paddingRight: 12 }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#51277C' }}>I1</Text>
                    <Text style={{ fontSize: 14, color: '#2A2333', lineHeight: 1.35, marginTop: 3 }}>
                        Today’s snack
                    </Text>
                </Box>
                <Box style={{ flex: 1, paddingRight: 14 }}>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45 }}>
                        Open a text file, locate the date, read a line
                    </Text>
                </Box>
                <Box style={{ flex: 1 }}>
                    <Text style={{ fontSize: 14, color: '#576420', lineHeight: 1.45 }}>
                        One screen after login — with the duty guardian’s WhatsApp link
                    </Text>
                    <Text style={{ fontSize: 12, color: '#6B6478', marginTop: 5 }}>
                        check-hari-ini-layout.mjs
                    </Text>
                </Box>
            </Box>
            <Box style={{ height: 1, background: 'rgba(81,39,124,0.14)' }} />

            <Box style={{ flexDirection: 'row', paddingTop: 16, paddingBottom: 16 }}>
                <Box style={{ width: 150, paddingRight: 12 }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#51277C' }}>I4</Text>
                    <Text style={{ fontSize: 14, color: '#2A2333', lineHeight: 1.35, marginTop: 3 }}>
                        Half-published classes
                    </Text>
                </Box>
                <Box style={{ flex: 1, paddingRight: 14 }}>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45 }}>
                        Not detectable — a file is sent or it is not
                    </Text>
                </Box>
                <Box style={{ flex: 1 }}>
                    <Text style={{ fontSize: 14, color: '#576420', lineHeight: 1.45, fontWeight: 'bold' }}>
                        Impossible. Publish refuses with 409 and names the class
                    </Text>
                    <Text style={{ fontSize: 12, color: '#6B6478', marginTop: 5 }}>
                        test-status.mjs · 22 assertions
                    </Text>
                </Box>
            </Box>
            <Box style={{ height: 1, background: 'rgba(81,39,124,0.14)' }} />

            <Box style={{ flexDirection: 'row', paddingTop: 16, paddingBottom: 16 }}>
                <Box style={{ width: 150, paddingRight: 12 }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#51277C' }}>I5</Text>
                    <Text style={{ fontSize: 14, color: '#2A2333', lineHeight: 1.35, marginTop: 3 }}>
                        Duty fairness
                    </Text>
                </Box>
                <Box style={{ flex: 1, paddingRight: 14 }}>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45 }}>
                        A feeling, unverifiable — the file records duty, not claims
                    </Text>
                </Box>
                <Box style={{ flex: 1 }}>
                    <Text style={{ fontSize: 14, color: '#576420', lineHeight: 1.45 }}>
                        A report ranking every parent by duties taken, plus who took none
                    </Text>
                    <Text style={{ fontSize: 12, color: '#6B6478', marginTop: 5 }}>
                        GET /api/laporan · claims-based
                    </Text>
                </Box>
            </Box>
            <Box style={{ height: 1, background: 'rgba(81,39,124,0.14)' }} />

            <Box style={{ flexDirection: 'row', paddingTop: 16, paddingBottom: 16 }}>
                <Box style={{ width: 150, paddingRight: 12 }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#51277C' }}>I6</Text>
                    <Text style={{ fontSize: 14, color: '#2A2333', lineHeight: 1.35, marginTop: 3 }}>
                        Claiming a date
                    </Text>
                </Box>
                <Box style={{ flex: 1, paddingRight: 14 }}>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45 }}>
                        The first reply in a group chat wins, untracked
                    </Text>
                </Box>
                <Box style={{ flex: 1 }}>
                    <Text style={{ fontSize: 14, color: '#576420', lineHeight: 1.45 }}>
                        Race-safe at the database level via UNIQUE(schedule_id)
                    </Text>
                    <Text style={{ fontSize: 12, color: '#6B6478', marginTop: 5 }}>
                        test-claim-cross-class.mjs · 9 assertions
                    </Text>
                </Box>
            </Box>
        </Box>

        {/* kanan: batas yang jujur */}
        <Box
            style={{
                flex: 40,
                background: 'rgba(81,39,124,0.06)',
                borderRadius: 10,
                paddingTop: 20,
                paddingBottom: 20,
                paddingLeft: 22,
                paddingRight: 22,
                borderTop: '3px solid #F3B26C',
                flexDirection: 'column',
            }}
        >
            <Text
                style={{
                    fontSize: 19,
                    fontWeight: 'bold',
                    color: '#c4762a',
                    fontFamily: 'Trebuchet MS',
                }}
            >
                Honest limits
            </Text>
            <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 10 }}>
                PDF export is not built — Excel is; the print-oriented PDF is still open.
            </Text>
            <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 9 }}>
                No push notifications. The app must be opened to be read.
            </Text>
            <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 9 }}>
                No student accounts — duty is modelled as a family obligation.
            </Text>
            <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 9 }}>
                No offline data: a stale schedule is worse than no schedule.
            </Text>
            <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 9 }}>
                No usage analytics, so adoption is measurable but not yet measured.
            </Text>
            <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 9 }}>
                import_logs is written but not surfaced.
            </Text>
            <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 9 }}>
                Single-school: no school_id column, so multi-tenancy would be a migration.
            </Text>
            <Box style={{ marginTop: 'auto', flexDirection: 'row', gap: 10, alignItems: 'center' }}>
                <Box style={{ width: 6, height: 22, background: '#F3B26C' }} />
                <Text style={{ fontSize: 14, color: '#51277C', lineHeight: 1.4, flex: 1 }}>
                    A description that claims no gaps is not a description of a real system.
                </Text>
            </Box>
        </Box>
    </Box>

    {/* ── zona C ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            justifyContent: 'space-between',
            alignItems: 'center',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478' }}>
            Pizza Snack Play · Visualization Project Description
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6478' }}>15 / 16</Text>
    </Box>
</Slide>
