<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
    }}
>
    {/* ── A · blok judul ── */}
    <Box style={{ height: 110, justifyContent: 'center' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#51277C',
                fontFamily: 'Trebuchet MS',
                lineHeight: 1.3,
            }}
        >
            Petugas piket: siapa yang ambil snack
        </Text>
        <Box style={{ marginTop: 10, width: 72, height: 6, borderRadius: 3, background: '#51277C' }} />
    </Box>

    {/* ── B · area konten ── */}
    <Box style={{ height: 530, flexDirection: 'row', gap: 26 }}>
        {/* kiri 30% · penanda */}
        <Box
            style={{
                width: '30%',
                height: '100%',
                background: 'linear-gradient(135deg, #51277C 0%, #7A45A8 100%)',
                borderRadius: 18,
                padding: 26,
                justifyContent: 'space-between',
            }}
        >
            <Box>
                <Text
                    style={{
                        fontSize: 30,
                        fontWeight: 'bold',
                        color: '#FFFFFF',
                        fontFamily: 'Trebuchet MS',
                        lineHeight: 1.25,
                    }}
                >
                    Satu tanggal,{'\n'}satu petugas
                </Text>
                <Box style={{ marginTop: 16, width: 64, height: 5, borderRadius: 3, background: '#F3B26C' }} />
            </Box>
            <Text
                style={{
                    fontSize: 17,
                    color: 'rgba(255,255,255,0.88)',
                    fontFamily: 'Verdana',
                    lineHeight: 1.5,
                }}
            >
                Nama petugas yang Anda isi akan tampil ke orang tua sekalian nama orang tuanya.
            </Text>
        </Box>

        {/* kanan 70% · tiga poin + ilustrasi dropdown */}
        <Box style={{ width: '70%', height: '100%', flexDirection: 'row', gap: 22 }}>
            <Box style={{ flex: 1, height: '100%', justifyContent: 'space-between' }}>
                {[
                    {
                        t: 'Pilih dari daftar siswa',
                        d: 'Kolom petugas berisi nama siswa di kelas Anda. Nama orang tuanya terisi sendiri.',
                    },
                    {
                        t: 'Biarkan kosong bila perlu',
                        d: 'Tanggal tanpa petugas bisa diambil sendiri orang tua — siapa cepat dia dapat.',
                    },
                    {
                        t: 'Tidak ikut direbut orang tua',
                        d: 'Ditandai "Ditetapkan korlas", jadi tidak ada dua orang merasa sudah dapat.',
                    },
                ].map((it, i) => (
                    <Box
                        key={i}
                        style={{
                            height: 165,
                            background: '#FFFFFF',
                            borderRadius: 16,
                            boxShadow: '0 4px 20px rgba(0,0,0,0.08)',
                            padding: 22,
                            borderLeft: '8px solid #AFC440',
                        }}
                    >
                        <Text
                            style={{
                                fontSize: 23,
                                fontWeight: 'bold',
                                color: '#51277C',
                                fontFamily: 'Trebuchet MS',
                                lineHeight: 1.3,
                            }}
                        >
                            {it.t}
                        </Text>
                        <Text
                            style={{
                                marginTop: 9,
                                fontSize: 17,
                                color: '#6B6478',
                                fontFamily: 'Verdana',
                                lineHeight: 1.5,
                            }}
                        >
                            {it.d}
                        </Text>
                    </Box>
                ))}
            </Box>

            <Box
                style={{
                    width: 300,
                    height: '100%',
                    background: 'rgba(81,39,124,0.06)',
                    borderRadius: 18,
                    justifyContent: 'center',
                    alignItems: 'center',
                }}
            >
                <svg width={276} height={300} viewBox='0 0 276 300'>
                    <text x='14' y='26' fontFamily='Verdana' fontSize='14' fill='#6B6478'>Petugas</text>
                    <rect x='14' y='38' width='248' height='48' rx='10' fill='#FFFFFF' stroke='#51277C' strokeWidth='2' />
                    <text x='34' y='68' fontFamily='Verdana' fontSize='16' fill='#51277C'>Rafa Aditya</text>
                    <path d='M232 58l16 12-16 12z' fill='#51277C' />

                    <rect x='14' y='94' width='248' height='112' rx='10' fill='#FFFFFF' stroke='#E6DFD2' strokeWidth='2' />
                    <rect x='14' y='94' width='248' height='36' rx='10' fill='rgba(81,39,124,0.10)' />
                    <text x='34' y='117' fontFamily='Verdana' fontSize='15' fontWeight='bold' fill='#51277C'>Rafa Aditya</text>
                    <text x='34' y='148' fontFamily='Verdana' fontSize='15' fill='#2A2333'>Dinda</text>
                    <text x='34' y='178' fontFamily='Verdana' fontSize='15' fill='#2A2333'>Bayu</text>

                    <text x='14' y='234' fontFamily='Verdana' fontSize='14' fill='#6B6478'>Orang tua (terisi sendiri)</text>
                    <rect x='14' y='246' width='248' height='44' rx='10' fill='#EFEAE1' />
                    <text x='34' y='274' fontFamily='Verdana' fontSize='15' fill='#6B6478'>Ibu Rina</text>
                </svg>
            </Box>
        </Box>
    </Box>

    {/* ── C · bilah kaki ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>
            Pizza Snack Play · Panduan Korlas &amp; Admin
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>10 / 16</Text>
    </Box>
</Slide>
