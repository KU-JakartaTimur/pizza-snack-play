<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        flexDirection: 'row',
        padding: 0,
        position: 'relative',
        overflow: 'hidden',
    }}
>
    {/* dekorasi latar */}
    <Box
        style={{
            position: 'absolute',
            top: -140,
            right: -120,
            width: 520,
            height: 520,
