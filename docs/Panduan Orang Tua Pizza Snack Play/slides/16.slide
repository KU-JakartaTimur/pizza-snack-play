<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        justifyContent: 'center',
        alignItems: 'center',
        position: 'relative',
        overflow: 'hidden',
    }}
>
    {/* cahaya latar */}
    <Box
        style={{
            position: 'absolute',
            top: 90,
            width: 520,
            height: 520,
            borderRadius: 260,
            background: 'linear-gradient(135deg, #51277C 0%, #7A45A8 100%)',
            opacity: 0.10,
        }}
    />
    <Box
        style={{
            position: 'absolute',
            bottom: -80,
            left: -80,
            width: 320,
            height: 320,
            borderRadius: 160,
            background: 'linear-gradient(135deg, #AFC440 0%, #F3B26C 100%)',
            opacity: 0.18,
        }}
    />

    <Box style={{ position: 'relative', zIndex: 1, alignItems: 'center', paddingLeft: 72, paddingRight: 72 }}>
        <Image
            src="assets/app_logo.png"
            style={{ width: 200, height: 194, objectFit: 'contain' }}
        />

        <Text
            style={{
                marginTop: 26,
                fontSize: 60,
                fontWeight: 'bold',
                color: '#51277C',
                fontFamily: 'Trebuchet MS',
                lineHeight: 1.15,
            }}
        >
            Terima kasih
        </Text>

        <Box style={{ marginTop: 18, width: 96, height: 7, borderRadius: 4, background: '#AFC440' }} />

        <Text
            style={{
                marginTop: 22,
                fontSize: 22,
                color: '#2A2333',
                fontFamily: 'Verdana',
                lineHeight: 1.5,
                textAlign: 'center',
            }}
        >
            Mari pasang aplikasinya hari ini juga.
        </Text>

        <Text
            style={{
                marginTop: 14,
                fontSize: 19,
                color: '#6B6478',
                fontFamily: 'Verdana',
                lineHeight: 1.5,
                textAlign: 'center',
            }}
        >
            Ada pertanyaan? Sampaikan kepada korlas kelas atau admin sekolah.
        </Text>

        <Box
            style={{
                marginTop: 26,
                flexDirection: 'row',
                alignItems: 'center',
                gap: 12,
                background: '#F3B26C',
                borderRadius: 999,
                paddingTop: 13,
                paddingBottom: 13,
                paddingLeft: 28,
                paddingRight: 30,
            }}
        >
            <svg width={22} height={22} viewBox="0 0 576 512" xmlns="http://www.w3.org/2000/svg"><path fill="#51277C" d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z" /></svg>
            <Text style={{ fontSize: 19, color: '#51277C', fontFamily: 'Trebuchet MS', fontWeight: 'bold' }}>
                Pizza Snack Play
            </Text>
        </Box>
    </Box>
</Slide>
