<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
    }}
>
    {/* ── A · blok judul ── */}
    <Box style={{ height: 110, justifyContent: 'center' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#51277C',
                fontFamily: 'Trebuchet MS',
                lineHeight: 1.3,
            }}
        >
            Tiga tugas Anda
        </Text>
        <Box style={{ marginTop: 10, width: 72, height: 6, borderRadius: 3, background: '#51277C' }} />
    </Box>

    {/* ── B · area konten ── */}
    <Box style={{ height: 530, flexDirection: 'row', gap: 30 }}>
        {/* kiri 55% · alur tiga langkah */}
        <Box
            style={{
                width: '55%',
                height: '100%',
                background: 'rgba(81,39,124,0.06)',
                borderRadius: 20,
                justifyContent: 'center',
                alignItems: 'center',
            }}
        >
            <svg width={520} height={430} viewBox='0 0 520 430'>
                {/* langkah 1 */}
                <rect x='14' y='8' width='492' height='112' rx='16' fill='#FFFFFF' stroke='#E6DFD2' strokeWidth='2' />
                <circle cx='62' cy='64' r='28' fill='#51277C' />
                <text x='62' y='74' fontFamily='Trebuchet MS' fontSize='28' fontWeight='bold' fill='#FFFFFF' textAnchor='middle'>
                    1
                </text>
                <text x='112' y='54' fontFamily='Trebuchet MS' fontSize='24' fontWeight='bold' fill='#51277C'>
                    Susun
                </text>
                <text x='112' y='86' fontFamily='Verdana' fontSize='16' fill='#6B6478'>
                    Menu untuk Senin sampai Jumat
                </text>
                {/* panah */}
                <path d='M260 126v30' stroke='#AFC440' strokeWidth='5' strokeLinecap='round' />
                <path d='M250 150l10 12 10-12' fill='none' stroke='#AFC440' strokeWidth='5' strokeLinecap='round' />

                {/* langkah 2 */}
                <rect x='14' y='164' width='492' height='112' rx='16' fill='#FFFFFF' stroke='#E6DFD2' strokeWidth='2' />
                <circle cx='62' cy='220' r='28' fill='#51277C' />
                <text x='62' y='230' fontFamily='Trebuchet MS' fontSize='28' fontWeight='bold' fill='#FFFFFF' textAnchor='middle'>
                    2
                </text>
                <text x='112' y='210' fontFamily='Trebuchet MS' fontSize='24' fontWeight='bold' fill='#51277C'>
                    Tentukan petugas
                </text>
                <text x='112' y='242' fontFamily='Verdana' fontSize='16' fill='#6B6478'>
                    Atau biarkan kosong supaya direbut orang tua
                </text>
                {/* panah */}
                <path d='M260 282v30' stroke='#AFC440' strokeWidth='5' strokeLinecap='round' />
                <path d='M250 306l10 12 10-12' fill='none' stroke='#AFC440' strokeWidth='5' strokeLinecap='round' />

                {/* langkah 3 */}
                <rect x='14' y='320' width='492' height='104' rx='16' fill='#51277C' />
                <circle cx='62' cy='372' r='28' fill='#F3B26C' />
                <text x='62' y='382' fontFamily='Trebuchet MS' fontSize='28' fontWeight='bold' fill='#51277C' textAnchor='middle'>
                    3
                </text>
                <text x='112' y='362' fontFamily='Trebuchet MS' fontSize='24' fontWeight='bold' fill='#FFFFFF'>
                    Umumkan
                </text>
                <text x='112' y='394' fontFamily='Verdana' fontSize='16' fill='#EFEAE1'>
                    Kunci lebih dulu, baru terbit ke orang tua
                </text>
            </svg>
        </Box>

        {/* kanan 45% · tiga keterangan */}
        <Box style={{ width: '45%', height: '100%', justifyContent: 'space-between' }}>
            {[
                {
                    t: 'Susun — isi menunya',
                    d: 'Satu bulan lebih baik dikerjakan sekaligus. Tiga cara: ketik per hari, salin dari minggu lain, atau tempel teks dari sekolah.',
                    g: 'Bagian 3',
                },
                {
                    t: 'Petugas — siapa ambil snack',
                    d: 'Pilih dari daftar siswa kelas Anda; nama orang tuanya terisi sendiri. Dikosongkan pun boleh.',
                    g: 'Bisa dikosongkan',
                },
                {
                    t: 'Umumkan — baru kelihatan',
                    d: 'Sebelum diumumkan, orang tua tidak melihat apa pun. Jadi jangan khawatir kalau belum muncul.',
                    g: 'Bagian 4',
                },
            ].map((it, i) => (
                <Box
                    key={i}
                    style={{
                        height: 166,
                        background: '#FFFFFF',
                        borderRadius: 16,
                        boxShadow: '0 4px 20px rgba(0,0,0,0.08)',
                        padding: 22,
                        borderLeft: i === 2 ? '8px solid #F3B26C' : '8px solid #AFC440',
                    }}
                >
                    <Text
                        style={{
                            fontSize: 24,
                            fontWeight: 'bold',
                            color: '#51277C',
                            fontFamily: 'Trebuchet MS',
                            lineHeight: 1.3,
                        }}
                    >
                        {it.t}
                    </Text>
                    <Text
                        style={{
                            marginTop: 10,
                            fontSize: 17,
                            color: '#6B6478',
                            fontFamily: 'Verdana',
                            lineHeight: 1.5,
                        }}
                    >
                        {it.d}
                    </Text>
                    <Box style={{ marginTop: 'auto' }}>
                        <Text
                            style={{
                                fontSize: 16,
                                color: '#51277C',
                                fontFamily: 'Verdana',
                                fontWeight: 'bold',
                            }}
                        >
                            {it.g}
                        </Text>
                    </Box>
                </Box>
            ))}
        </Box>
    </Box>

    {/* ── C · bilah kaki ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>
            Pizza Snack Play · Panduan Korlas &amp; Admin
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>04 / 17</Text>
    </Box>
</Slide>
