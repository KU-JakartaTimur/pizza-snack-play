<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
    }}
>
    {/* ── A · blok judul ── */}
    <Box style={{ height: 110, justifyContent: 'center' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#51277C',
                fontFamily: 'Trebuchet MS',
                lineHeight: 1.3,
            }}
        >
            Masuk memakai akun dari sekolah
        </Text>
        <Box style={{ marginTop: 10, width: 72, height: 6, borderRadius: 3, background: '#51277C' }} />
    </Box>

    {/* ── B · area konten ── */}
    <Box style={{ height: 530, flexDirection: 'row', gap: 28 }}>
        {/* kiri 30% · panel ungu */}
        <Box
            style={{
                width: '30%',
                height: '100%',
                background: 'linear-gradient(135deg, #51277C 0%, #7A45A8 100%)',
                borderRadius: 20,
                padding: 26,
                justifyContent: 'space-between',
                alignItems: 'center',
            }}
        >
            <Box style={{ alignItems: 'center' }}>
                <Text
                    style={{
                        fontSize: 16,
                        color: 'rgba(255,255,255,0.75)',
                        fontFamily: 'Verdana',
                    }}
                >
                    Langkah 2
                </Text>
                <Text
                    style={{
                        marginTop: 8,
                        fontSize: 40,
                        fontWeight: 'bold',
                        color: '#FFFFFF',
                        fontFamily: 'Trebuchet MS',
                    }}
                >
                    Masuk
                </Text>
            </Box>

            <svg width={170} height={170} viewBox='0 0 170 170'>
                <rect x='34' y='74' width='102' height='80' rx='14' fill='#F3B26C' />
                <path
                    d='M58 74 v-20 a27 27 0 0 1 54 0 v20'
                    fill='none'
                    stroke='#FFFFFF'
                    strokeWidth='10'
                    strokeLinecap='round'
                />
                <circle cx='85' cy='108' r='10' fill='#51277C' />
                <rect x='81' y='114' width='8' height='20' rx='4' fill='#51277C' />
                <circle cx='132' cy='44' r='22' fill='none' stroke='#AFC440' strokeWidth='8' />
                <path d='M148 60 l16 16' stroke='#AFC440' strokeWidth='8' strokeLinecap='round' />
            </svg>

            <Text
                style={{
                    fontSize: 17,
                    color: 'rgba(255,255,255,0.9)',
                    fontFamily: 'Verdana',
                    lineHeight: 1.5,
                    textAlign: 'center',
                }}
            >
                Wajib masuk dulu sebelum jadwal bisa dilihat.
            </Text>
        </Box>

        {/* kanan 70% · empat keterangan */}
        <Box style={{ width: '70%', height: '100%', justifyContent: 'space-between' }}>
            {[
                {
                    vb: '0 0 448 512',
                    d: 'M224 256A128 128 0 1 0 224 0a128 128 0 1 0 0 256zm-45.7 48C79.8 304 0 383.8 0 482.3C0 498.7 13.3 512 29.7 512H418.3c16.4 0 29.7-13.3 29.7-29.7C448 383.8 368.2 304 269.7 304H178.3z',
                    t: 'Akunnya dibuatkan sekolah',
                    d: 'Username dan password diberikan oleh admin sekolah. Bapak/Ibu tidak perlu mendaftar sendiri.',
                },
                {
                    vb: '0 0 640 512',
                    d: 'M144 0a80 80 0 1 1 0 160A80 80 0 1 1 144 0zM512 0a80 80 0 1 1 0 160A80 80 0 1 1 512 0zM0 298.7C0 239.8 47.8 192 106.7 192h42.7c15.9 0 31 3.5 44.6 9.7c-1.3 7.2-1.9 14.7-1.9 22.3c0 38.2 16.8 72.5 43.3 96c-.2 0-.4 0-.7 0H21.3C9.6 320 0 310.4 0 298.7zM405.3 320c-.2 0-.4 0-.7 0c26.6-23.5 43.3-57.8 43.3-96c0-7.6-.7-15-1.9-22.3c13.6-6.3 28.7-9.7 44.6-9.7h42.7C592.2 192 640 239.8 640 298.7c0 11.8-9.6 21.3-21.3 21.3H405.3zM224 224a96 96 0 1 1 192 0 96 96 0 1 1 -192 0zM128 485.3C128 411.7 187.7 352 261.3 352H378.7C452.3 352 512 411.7 512 485.3c0 14.7-11.9 26.7-26.7 26.7H154.7c-14.7 0-26.7-11.9-26.7-26.7z',
                    t: 'Satu akun bisa untuk beberapa anak',
                    d: 'Punya dua anak di kelas berbeda? Cukup satu akun — pilih kelasnya di bagian atas layar. Anak bisa ditambah di menu Profil.',
                },
                {
                    vb: '0 0 512 512',
                    d: 'M336 352c97.2 0 176-78.8 176-176S433.2 0 336 0S160 78.8 160 176c0 18.7 2.9 36.8 8.3 53.7L7 391c-4.5 4.5-7 10.6-7 17v80c0 13.3 10.7 24 24 24h80c13.3 0 24-10.7 24-24V448h40c13.3 0 24-10.7 24-24V384h40c6.4 0 12.5-2.5 17-7l33.3-33.3c16.9 5.4 35 8.3 53.7 8.3zM376 96a40 40 0 1 1 0 80 40 40 0 1 1 0-80z',
                    t: 'Password bisa diganti sendiri',
                    d: 'Ada menu Profil di dalam aplikasi. Kalau lupa, minta reset kepada admin sekolah sebelum salah mencoba berulang kali.',
                },
                {
                    vb: '0 0 448 512',
                    d: 'M144 144v48H304V144c0-44.2-35.8-80-80-80s-80 35.8-80 80zM80 192V144C80 64.5 144.5 0 224 0s144 64.5 144 144v48h16c35.3 0 64 28.7 64 64V448c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V256c0-35.3 28.7-64 64-64H80z',
                    t: 'Hati-hati: 5 kali salah, akun terkunci',
                    d: 'Salah password 5 kali berturut-turut mengunci akun. Tidak bisa dibuka sendiri — hubungi admin sekolah, nanti dibukakan.',
                    warn: true,
                },
                {
                    vb: '0 0 512 512',
                    d: 'M256 0c4.6 0 9.2 1 13.4 2.9L457.7 82.8c22 9.3 38.4 31 38.3 57.2c-.5 99.2-41.3 280.7-213.6 363.2c-16.7 8-36.1 8-52.8 0C57.3 420.7 16.5 239.2 16 140c-.1-26.2 16.3-47.9 38.3-57.2L242.7 2.9C246.8 1 251.4 0 256 0z',
                    t: 'Kenapa harus masuk?',
                    d: 'Supaya jadwal dan nama anak hanya dilihat oleh orang tuanya sendiri, bukan orang lain.',
                },
            ].map((c, idx) => (
                <Box
                    key={idx}
                    style={{
                        height: 100,
                        flexDirection: 'row',
                        alignItems: 'center',
                        gap: 20,
                        background: '#FFFFFF',
                        borderRadius: 16,
                        boxShadow: '0 4px 20px rgba(0,0,0,0.08)',
                        paddingLeft: 24,
                        paddingRight: 26,
                        borderLeft: c.warn ? '8px solid #F3B26C' : '8px solid #AFC440',
                    }}
                >
                    <Box
                        style={{
                            width: 54,
                            height: 54,
                            borderRadius: 27,
                            background: 'rgba(81,39,124,0.10)',
                            justifyContent: 'center',
                            alignItems: 'center',
                        }}
                    >
                        <svg width={28} height={28} viewBox={c.vb} xmlns="http://www.w3.org/2000/svg"><path fill="#51277C" d={c.d} /></svg>
                    </Box>
                    <Box style={{ flex: 1 }}>
                        <Text
                            style={{
                                fontSize: 24,
                                fontWeight: 'bold',
                                color: '#2A2333',
                                fontFamily: 'Trebuchet MS',
                                lineHeight: 1.3,
                            }}
                        >
                            {c.t}
                        </Text>
                        <Text
                            style={{
                                marginTop: 5,
                                fontSize: 18,
                                color: '#6B6478',
                                fontFamily: 'Verdana',
                                lineHeight: 1.45,
                            }}
                        >
                            {c.d}
                        </Text>
                    </Box>
                </Box>
            ))}
        </Box>
    </Box>

    {/* ── C · bilah kaki ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>
            Pizza Snack Play · Panduan Orang Tua
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>08 / 15</Text>
    </Box>
</Slide>
