# ─── Cloudflare D1 ────────────────────────────────────────────────
# Dapatkan dari: bunx wrangler d1 create pizza-snack-play
# Lalu salin database_id yang dihasilkan ke wrangler.json juga.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# ─── Autentikasi ─────────────────────────────────────────────────
# Dipakai untuk signing JWT (HS256) via hono/jwt.
# Generate nilai acak, contoh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Untuk produksi, simpan sebagai Worker Secret:
#   bunx wrangler secret put JWT_SECRET
JWT_SECRET=

# Masa berlaku token (detik). 604800 = 7 hari
JWT_EXPIRES_IN=604800

# ─── Push Notification (PWA) ─────────────────────────────────────
# Pasangan kunci VAPID untuk Web Push. Generate dengan:
#   node scripts/generate-vapid.mjs
# Untuk produksi, simpan sebagai Worker Secret:
#   bunx wrangler secret put VAPID_PUBLIC_KEY
#   bunx wrangler secret put VAPID_PRIVATE_KEY
#   bunx wrangler secret put VAPID_SUBJECT
# VAPID_PUBLIC_KEY  = kunci publik (base64url)
# VAPID_PRIVATE_KEY = kunci privat (JSON JWK, satu baris)
# VAPID_SUBJECT     = kontak admin, mis. mailto:admin@sekolah.id
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sekolah.id

# ─── Notifikasi WhatsApp (sikuwa) ────────────────────────────────
# Transport: paket `sikuwa` (multi-gateway). Pilih SATU gateway lewat
# WHATSAPP_PROVIDER, lalu isi tokennya. Gateway yang dikenal:
#   Fonnte, OpenWA, ApiMe, EvolutionAPI, Wuzapi, Wwebjs, Waxum
#
# Simpan sebagai Worker Secret:
#   bunx wrangler secret put WHATSAPP_PROVIDER
#   bunx wrangler secret put WHATSAPP_TOKEN_OpenWA   # sesuai provider
#   bunx wrangler secret put WHATSAPP_URL            # bila self-hosted
#   bunx wrangler secret put WHATSAPP_SESSION        # id session tersambung
#
# Kunci per-provider (WHATSAPP_TOKEN_<Provider>, WHATSAPP_URL_<Provider>,
# WHATSAPP_SESSION_<Provider>) menang atas kunci umum — dipakai bila satu
# sekolah memakai lebih dari satu gateway.
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_URL=
WHATSAPP_SESSION=

# Opsional — bawaannya mati.
# Jeda antar pesan beruntun, mis. "0,30" (pesan ke-2 jeda 30 detik).
WHATSAPP_PACING_CYCLE=
# Indikator "sedang mengetik" sebelum tiap pesan.
WHATSAPP_TYPING=
# Percobaan ulang saat gateway menolak 429/503 dengan Retry-After.
WHATSAPP_RETRIES=
# "1" = periksa dulu apakah nomor terdaftar di WhatsApp sebelum mengirim.
WHATSAPP_CHECK_NUMBERS=

# Kunci lama (TIDAK dipakai lagi, hanya untuk migrasi):
# WHATSAPP_GATEWAY_URL / WHATSAPP_GATEWAY_KEY digantikan WHATSAPP_PROVIDER
# + WHATSAPP_TOKEN_<Provider> di atas.
