                    style={{
                        fontSize: 84,
                        fontWeight: 'bold',
                        color: '#51277C',
                        lineHeight: 1.05,
                        fontFamily: 'Trebuchet MS',
                    }}
                >
                    113
                </Text>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#2A2333', marginTop: 10 }}>commit dalam 31 hari</Text>
                <Text style={{ fontSize: 15, color: '#6B6478', lineHeight: 1.5, marginTop: 8 }}>Di 17 hari aktif — rata-rata 6,6 commit pada hari proyek bergerak.</Text>
            </Box>

            <Box style={{ flex: 1, flexDirection: 'column' }}>
