<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
        position: 'relative',
        overflow: 'hidden',
    }}
>
    <Box
        style={{
            position: 'absolute',
            bottom: -140,
            right: -110,
            width: 460,
            height: 460,
            borderRadius: 230,
            background: 'linear-gradient(135deg, #51277C 0%, #7A45A8 100%)',
            opacity: 0.09,
        }}
    />

    {/* ── A · blok judul ── */}
    <Box style={{ height: 110, justifyContent: 'center' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#51277C',
                fontFamily: 'Trebuchet MS',
                lineHeight: 1.3,
            }}
        >
            Terkunci, lalu terbit
        </Text>
        <Box style={{ marginTop: 10, width: 72, height: 6, borderRadius: 3, background: '#F3B26C' }} />
    </Box>

    {/* ── B · area konten ── */}
    <Box style={{ height: 530, flexDirection: 'row', gap: 34, position: 'relative', zIndex: 1 }}>
        {/* kiri 55% · frasa raksasa */}
        <Box style={{ width: '55%', height: '100%', justifyContent: 'center' }}>
            <Text
                style={{
                    fontSize: 64,
                    fontWeight: 'bold',
                    color: '#51277C',
                    fontFamily: 'Trebuchet MS',
                    lineHeight: 1.1,
                }}
            >
                Kunci dulu,{'\n'}baru terbit.
            </Text>

            <Text
                style={{
                    marginTop: 22,
                    fontSize: 19,
                    color: '#2A2333',
                    fontFamily: 'Verdana',
                    lineHeight: 1.55,
                }}
            >
                Orang tua baru melihat jadwal setelah diterbitkan. Selama belum, jadwalnya
                tetap tersimpan — hanya belum diumumkan.
            </Text>

            <Box
                style={{
                    marginTop: 24,
                    background: 'rgba(243,178,108,0.22)',
                    borderRadius: 14,
                    borderLeft: '8px solid #F3B26C',
                    padding: 18,
                }}
            >
                <Text
                    style={{
                        fontSize: 18,
                        color: '#2A2333',
                        fontFamily: 'Verdana',
                        lineHeight: 1.5,
                    }}
                >
                    Publikasi menolak selama masih ada hari yang belum dikunci. Selesaikan
                    semuanya lebih dulu, baru tekan Publikasi.
                </Text>
            </Box>
        </Box>

        {/* kanan 45% · tiga status */}
        <Box
            style={{
                width: '45%',
                height: '100%',
                background: 'rgba(81,39,124,0.06)',
                borderRadius: 20,
                justifyContent: 'center',
                alignItems: 'center',
            }}
        >
            <svg width={430} height={430} viewBox='0 0 430 430'>
                {/* 1 · masih bisa diubah */}
                <rect x='18' y='14' width='394' height='112' rx='16' fill='#FFFFFF' stroke='#DED7CB' strokeWidth='2' />
                <circle cx='66' cy='70' r='26' fill='#DED7CB' />
                <text x='66' y='80' fontFamily='Trebuchet MS' fontSize='24' fontWeight='bold' fill='#FFFFFF' textAnchor='middle'>
                    1
                </text>
                <text x='110' y='62' fontFamily='Trebuchet MS' fontSize='22' fontWeight='bold' fill='#51277C'>
                    Masih bisa diubah
                </text>
                <text x='110' y='94' fontFamily='Verdana' fontSize='15' fill='#6B6478'>
                    disusun korlas
                </text>

                {/* 2 · dikunci */}
                <rect x='18' y='152' width='394' height='112' rx='16' fill='#FFFFFF' stroke='#AFC440' strokeWidth='3' />
                <circle cx='66' cy='208' r='26' fill='#AFC440' />
                <text x='66' y='218' fontFamily='Trebuchet MS' fontSize='24' fontWeight='bold' fill='#FFFFFF' textAnchor='middle'>
                    2
                </text>
                <text x='110' y='200' fontFamily='Trebuchet MS' fontSize='22' fontWeight='bold' fill='#51277C'>
                    Dikunci
                </text>
                <text x='110' y='232' fontFamily='Verdana' fontSize='15' fill='#6B6478'>
                    sudah tidak bisa diedit
                </text>

                {/* 3 · terbit */}
                <rect x='18' y='290' width='394' height='126' rx='16' fill='#51277C' />
                <circle cx='66' cy='352' r='26' fill='#F3B26C' />
                <text x='66' y='362' fontFamily='Trebuchet MS' fontSize='24' fontWeight='bold' fill='#51277C' textAnchor='middle'>
                    3
                </text>
                <text x='110' y='344' fontFamily='Trebuchet MS' fontSize='22' fontWeight='bold' fill='#FFFFFF'>
                    Terbit ke orang tua
                </text>
                <text x='110' y='376' fontFamily='Verdana' fontSize='15' fill='#EFEAE1'>
                    tampil di HP mereka
                </text>
                <text x='110' y='400' fontFamily='Verdana' fontSize='14' fill='#F3B26C'>
                    revisi? minta admin membuka kunci
                </text>
            </svg>
        </Box>
    </Box>

    {/* ── C · bilah kaki ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>
            Pizza Snack Play · Panduan Korlas &amp; Admin
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>13 / 17</Text>
    </Box>
</Slide>
