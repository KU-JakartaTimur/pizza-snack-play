<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
    }}
>
    {/* ── A · blok judul ── */}
    <Box style={{ height: 110, justifyContent: 'center' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#51277C',
                fontFamily: 'Trebuchet MS',
                lineHeight: 1.3,
            }}
        >
            Isi menu per hari
        </Text>
        <Box style={{ marginTop: 10, width: 72, height: 6, borderRadius: 3, background: '#51277C' }} />
    </Box>

    {/* ── B · area konten ── */}
    <Box style={{ height: 530 }}>
        {/* atas · ilustrasi tabel jadwal */}
        <Box
            style={{
                height: 306,
                background: 'rgba(81,39,124,0.06)',
                borderRadius: 20,
                justifyContent: 'center',
                alignItems: 'center',
            }}
        >
            <svg width={1100} height={270} viewBox='0 0 1100 270'>
                <rect x='6' y='6' width='1088' height='46' rx='10' fill='#51277C' />
                <text x='46' y='37' fontFamily='Trebuchet MS' fontSize='20' fontWeight='bold' fill='#FFFFFF'>
                    Tanggal
                </text>
                <text x='330' y='37' fontFamily='Trebuchet MS' fontSize='20' fontWeight='bold' fill='#FFFFFF'>
                    Menu
                </text>
                <text x='760' y='37' fontFamily='Trebuchet MS' fontSize='20' fontWeight='bold' fill='#FFFFFF'>
                    Petugas
                </text>
                <text x='990' y='37' fontFamily='Trebuchet MS' fontSize='20' fontWeight='bold' fill='#FFFFFF'>
                    Status
                </text>

                {/* Senin */}
                <rect x='6' y='60' width='1088' height='46' rx='10' fill='#FFFFFF' stroke='#E6DFD2' strokeWidth='2' />
                <text x='46' y='90' fontFamily='Verdana' fontSize='16' fill='#51277C'>Senin, 5</text>
                <text x='330' y='90' fontFamily='Verdana' fontSize='16' fill='#2A2333'>Roti coklat + jeruk</text>
                <text x='760' y='90' fontFamily='Verdana' fontSize='16' fill='#6B6478'>Rafa</text>
                <rect x='940' y='71' width='118' height='24' rx='12' fill='#DED7CB' />
                <text x='999' y='88' fontFamily='Verdana' fontSize='13' fill='#51277C' textAnchor='middle'>bisa diubah</text>

                {/* Selasa */}
                <rect x='6' y='112' width='1088' height='46' rx='10' fill='#FFFFFF' stroke='#E6DFD2' strokeWidth='2' />
                <text x='46' y='142' fontFamily='Verdana' fontSize='16' fill='#51277C'>Selasa, 6</text>
                <text x='330' y='142' fontFamily='Verdana' fontSize='16' fill='#2A2333'>Puding + pisang</text>
                <text x='760' y='142' fontFamily='Verdana' fontSize='16' fill='#6B6478'>—</text>
                <rect x='940' y='123' width='118' height='24' rx='12' fill='#DED7CB' />
                <text x='999' y='140' fontFamily='Verdana' fontSize='13' fill='#51277C' textAnchor='middle'>bisa diubah</text>

                {/* Rabu — libur */}
                <rect x='6' y='164' width='1088' height='46' rx='10' fill='#FFFFFF' stroke='#F3B26C' strokeWidth='2' />
                <text x='46' y='194' fontFamily='Verdana' fontSize='16' fill='#51277C'>Rabu, 7</text>
                <text x='330' y='194' fontFamily='Verdana' fontSize='16' fill='#2A2333'>Libur</text>
                <text x='760' y='194' fontFamily='Verdana' fontSize='16' fill='#6B6478'>—</text>
                <rect x='940' y='175' width='118' height='24' rx='12' fill='#F3B26C' />
                <text x='999' y='192' fontFamily='Verdana' fontSize='13' fill='#51277C' textAnchor='middle'>libur</text>

                {/* Kamis — petugas kosong */}
                <rect x='6' y='216' width='1088' height='46' rx='10' fill='#FFFFFF' stroke='#AFC440' strokeWidth='3' />
                <text x='46' y='246' fontFamily='Verdana' fontSize='16' fill='#51277C'>Kamis, 8</text>
                <text x='330' y='246' fontFamily='Verdana' fontSize='16' fill='#2A2333'>Donat + melon</text>
                <text x='760' y='246' fontFamily='Verdana' fontSize='16' fill='#6B6478'>—</text>
                <rect x='940' y='227' width='118' height='24' rx='12' fill='#AFC440' />
                <text x='999' y='244' fontFamily='Verdana' fontSize='13' fill='#3F4718' textAnchor='middle'>petugas kosong</text>
            </svg>
        </Box>

        {/* bawah · dua kartu 60:40 */}
        <Box style={{ marginTop: 18, height: 206, flexDirection: 'row', gap: 24 }}>
            <Box
                style={{
                    width: '60%',
                    background: '#FFFFFF',
                    borderRadius: 16,
                    boxShadow: '0 4px 20px rgba(0,0,0,0.08)',
                    padding: 24,
                    borderLeft: '8px solid #AFC440',
                }}
            >
                <Text
                    style={{
                        fontSize: 26,
                        fontWeight: 'bold',
                        color: '#51277C',
                        fontFamily: 'Trebuchet MS',
                    }}
                >
                    Pilih menu di setiap tanggal
                </Text>
                <Text
                    style={{
                        marginTop: 10,
                        fontSize: 18,
                        color: '#6B6478',
                        fontFamily: 'Verdana',
                        lineHeight: 1.5,
                    }}
                >
                    Satu hari berisi makanan utama dan buah pendamping. Hari yang tidak masuk
                    sekolah cukup ditandai libur — menunya tidak perlu diisi.
                </Text>
            </Box>

            <Box
                style={{
                    width: '40%',
                    background: '#FFFFFF',
                    borderRadius: 16,
                    boxShadow: '0 4px 20px rgba(0,0,0,0.08)',
                    padding: 24,
                    borderLeft: '8px solid #F3B26C',
                }}
            >
                <Text
                    style={{
                        fontSize: 26,
                        fontWeight: 'bold',
                        color: '#51277C',
                        fontFamily: 'Trebuchet MS',
                    }}
                >
                    Salin Sepekan
                </Text>
                <Text
                    style={{
                        marginTop: 10,
                        fontSize: 18,
                        color: '#6B6478',
                        fontFamily: 'Verdana',
                        lineHeight: 1.5,
                    }}
                >
                    Duplikasi Senin–Jumat ke minggu lain. Tanggal yang sudah terisi dilewati.
                </Text>
            </Box>
        </Box>
    </Box>

    {/* ── C · bilah kaki ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>
            Pizza Snack Play · Panduan Korlas &amp; Admin
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>08 / 16</Text>
    </Box>
</Slide>
