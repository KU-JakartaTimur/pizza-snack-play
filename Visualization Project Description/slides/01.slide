                lineHeight: 1.55,
                marginTop: 24,
                fontFamily: 'Verdana',
            }}
        >
            A school snack duty & menu scheduling platform — generated by prompt, verified by
            tests, and running in production for a real school.
        </Text>

        <Box style={{ flexDirection: 'row', gap: 44, marginTop: 46 }}>
            <Box style={{ flexDirection: 'column' }}>
                <Text
                    style={{
                        fontSize: 30,
                        fontWeight: 'bold',
                        color: '#51277C',
                        fontFamily: 'Trebuchet MS',
                    }}
                >
                    113
                </Text>
                <Text style={{ fontSize: 13, color: '#6B6478', marginTop: 4 }}>
                    commits in 31 days
                </Text>
            </Box>
            <Box style={{ flexDirection: 'column' }}>
                <Text
                    style={{
                        fontSize: 30,
                        fontWeight: 'bold',
                        color: '#51277C',
                        fontFamily: 'Trebuchet MS',
                    }}
                >
                    65
                </Text>
                <Text style={{ fontSize: 13, color: '#6B6478', marginTop: 4 }}>
                    API endpoints
                </Text>
            </Box>
            <Box style={{ flexDirection: 'column' }}>
                <Text
                    style={{
                        fontSize: 30,
                        fontWeight: 'bold',
                        color: '#c4762a',
                        fontFamily: 'Trebuchet MS',
                    }}
                >
                    0
                </Text>
                <Text style={{ fontSize: 13, color: '#6B6478', marginTop: 4 }}>
