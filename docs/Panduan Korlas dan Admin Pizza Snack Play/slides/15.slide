<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
    }}
>
    {/* ── A · blok judul ── */}
    <Box style={{ height: 110, justifyContent: 'center' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#51277C',
                fontFamily: 'Trebuchet MS',
                lineHeight: 1.3,
            }}
        >
            Keterangan bulan: sudah berapa yang terisi?
        </Text>
        <Box style={{ marginTop: 10, width: 72, height: 6, borderRadius: 3, background: '#AFC440' }} />
    </Box>

    {/* ── B · area konten ── */}
    <Box style={{ height: 530, justifyContent: 'space-between' }}>
        {/* kartu besar · tiruan panel Keterangan */}
        <Box
            style={{
                height: 352,
                background: '#FFFFFF',
                borderRadius: 18,
                boxShadow: '0 4px 20px rgba(0,0,0,0.08)',
                borderTop: '8px solid #51277C',
                padding: 26,
            }}
        >
            <Text
                style={{
                    fontSize: 26,
                    fontWeight: 'bold',
                    color: '#51277C',
                    fontFamily: 'Trebuchet MS',
                    lineHeight: 1.3,
                }}
            >
                Keterangan September 2026
            </Text>
            <Text
                style={{
                    marginTop: 5,
                    fontSize: 16,
                    color: '#6B6478',
                    fontFamily: 'Verdana',
                    lineHeight: 1.45,
                }}
            >
                Kelas 1 · jumlah snack yang sudah diambil pada bulan ini
            </Text>

            <Box style={{ marginTop: 18, flexDirection: 'row', gap: 14 }}>
                {[
                    { l: 'Sudah diambil', v: '12', c: '#51277C' },
                    { l: 'Ditetapkan korlas', v: '5', c: '#AFC440' },
                    { l: 'Masih kosong', v: '3', c: '#F3B26C' },
                    { l: 'Total tanggal', v: '20', c: '#6B6478' },
                ].map((it, i) => (
                    <Box
                        key={i}
                        style={{
                            flex: 1,
                            height: 112,
                            background: 'rgba(81,39,124,0.05)',
                            borderRadius: 14,
                            borderTop: '4px solid ' + it.c,
                            padding: 16,
                        }}
                    >
                        <Text
                            style={{
                                fontSize: 15,
                                color: '#6B6478',
                                fontFamily: 'Verdana',
                                lineHeight: 1.35,
                            }}
                        >
                            {it.l}
                        </Text>
                        <Text
                            style={{
                                marginTop: 6,
                                fontSize: 36,
                                fontWeight: 'bold',
                                color: '#51277C',
                                fontFamily: 'Trebuchet MS',
                                lineHeight: 1.1,
                            }}
                        >
                            {it.v}
                        </Text>
                    </Box>
                ))}
            </Box>

            <Box
                style={{
                    marginTop: 20,
                    flexDirection: 'row',
                    justifyContent: 'space-between',
                    alignItems: 'flex-end',
                }}
            >
                <Text style={{ fontSize: 15, color: '#6B6478', fontFamily: 'Verdana' }}>
                    17 dari 20 tanggal sudah ada petugas
                </Text>
                <Text
                    style={{
                        fontSize: 16,
                        fontWeight: 'bold',
                        color: '#2A2333',
                        fontFamily: 'Verdana',
                    }}
                >
                    85%
                </Text>
            </Box>
            <Box
                style={{
                    marginTop: 8,
                    height: 12,
                    borderRadius: 6,
                    background: '#EFEAE1',
                    flexDirection: 'row',
                }}
            >
                <Box style={{ width: '85%', height: 12, borderRadius: 6, background: '#AFC440' }} />
            </Box>
        </Box>

        {/* jalur bawah · di mana panelnya & siapa yang melihat */}
        <Box
            style={{
                height: 150,
                background: 'rgba(81,39,124,0.06)',
                borderRadius: 16,
                borderLeft: '8px solid #F3B26C',
                padding: 22,
            }}
        >
            <Text
                style={{
                    fontSize: 21,
                    fontWeight: 'bold',
                    color: '#51277C',
                    fontFamily: 'Trebuchet MS',
                    lineHeight: 1.3,
                }}
            >
                Ada di halaman Pilih Jadwal — hanya korlas &amp; admin
            </Text>
            <Text
                style={{
                    marginTop: 8,
                    fontSize: 17,
                    color: '#2A2333',
                    fontFamily: 'Verdana',
                    lineHeight: 1.5,
                }}
            >
                Orang tua tidak melihat panel ini: yang ia butuhkan cuma tanggal mana yang masih
                kosong. Admin melihat panelnya tanpa papan tanggal, karena ia tidak ikut mengambil.
            </Text>
        </Box>
    </Box>

    {/* ── C · bilah kaki ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>
            Pizza Snack Play · Panduan Korlas &amp; Admin
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>15 / 18</Text>
    </Box>
</Slide>
