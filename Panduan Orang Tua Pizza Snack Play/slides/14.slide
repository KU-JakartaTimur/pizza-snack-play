<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
    }}
>
    {/* ── A · blok judul ── */}
    <Box style={{ height: 110, justifyContent: 'center' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#51277C',
                fontFamily: 'Trebuchet MS',
                lineHeight: 1.3,
            }}
        >
            Empat hal yang perlu diingat
        </Text>
        <Box style={{ marginTop: 10, width: 72, height: 6, borderRadius: 3, background: '#51277C' }} />
    </Box>

    {/* ── B · area konten ── */}
    <Box style={{ height: 530 }}>
        <Box style={{ height: 470, flexDirection: 'row', gap: 18 }}>
            {[
                {
                    i: 'clock',
                    t: 'Jadwal muncul setelah diumumkan',
                    d: 'Jadwal baru tampil setelah korlas atau admin sekolah mengumumkannya. Kalau hari itu belum muncul, berarti belum diumumkan — bukan hilang.',
                    g: 'Sabar menunggu',
                },
                {
                    i: 'users',
                    t: 'Satu akun untuk beberapa anak',
                    d: 'Punya dua anak di kelas berbeda tidak perlu akun tambahan. Pilih kelasnya di bagian atas layar, jadwalnya ikut berganti.',
                    g: 'Tidak perlu daftar ulang',
                },
                {
                    i: 'home',
                    t: 'Ambil tanggal di kelas anak sendiri',
                    d: 'Setiap kelas punya baris jadwalnya sendiri. Mengambil tanggal di kelas lain tidak bisa, dan tanggal di kelas anak tidak tertutup oleh kelas lain.',
                    g: 'Adil per kelas',
                },
                {
                    i: 'phone',
                    t: 'Perubahan lewat korlas kelas',
                    d: 'Jadwal yang sudah diumumkan tidak bisa diubah sendiri. Sampaikan ke korlas kelas atau admin sekolah bila ada keperluan mendadak.',
                    g: 'Jangan diubah sendiri',
                },
            ].map((c, idx) => (
                <Box
                    key={idx}
                    style={{
                        flex: 1,
                        height: '100%',
                        background: '#FFFFFF',
                        borderRadius: 16,
                        boxShadow: '0 4px 20px rgba(0,0,0,0.08)',
                        padding: 24,
                        borderTop: '8px solid #AFC440',
                    }}
                >
                    <Box
                        style={{
                            width: 60,
                            height: 60,
                            borderRadius: 30,
                            background: 'rgba(81,39,124,0.10)',
                            justifyContent: 'center',
                            alignItems: 'center',
                        }}
                    >
                        <FAIcon name={c.i} style={{ fill: '#51277C', width: 30, height: 30 }} />
                    </Box>

                    <Text
                        style={{
                            marginTop: 16,
                            fontSize: 23,
                            fontWeight: 'bold',
                            color: '#51277C',
                            fontFamily: 'Trebuchet MS',
                            lineHeight: 1.32,
                        }}
                    >
                        {c.t}
                    </Text>

                    <Box
                        style={{
                            marginTop: 12,
                            width: 44,
                            height: 3,
                            borderRadius: 2,
                            background: '#AFC440',
                        }}
                    />

                    <Text
                        style={{
                            marginTop: 12,
                            fontSize: 18,
                            color: '#6B6478',
                            fontFamily: 'Verdana',
                            lineHeight: 1.55,
                        }}
                    >
                        {c.d}
                    </Text>

                    <Box style={{ marginTop: 'auto' }}>
                        <Text
                            style={{
                                fontSize: 16,
                                color: '#51277C',
                                fontFamily: 'Verdana',
                                fontWeight: 'bold',
                            }}
                        >
                            {c.g}
                        </Text>
                    </Box>
                </Box>
            ))}
        </Box>

        {/* simpulan */}
        <Box
            style={{
                marginTop: 14,
                height: 46,
                background: '#51277C',
                borderRadius: 14,
                justifyContent: 'center',
                alignItems: 'center',
            }}
        >
            <Text
                style={{
                    fontSize: 19,
                    color: '#FFFFFF',
                    fontFamily: 'Verdana',
                    fontWeight: 'bold',
                }}
            >
                Intinya: satu akun, satu aplikasi, dan semua perubahan disampaikan lewat korlas kelas.
            </Text>
        </Box>
    </Box>

    {/* ── C · bilah kaki ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>
            Pizza Snack Play · Panduan Orang Tua
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>14 / 15</Text>
    </Box>
</Slide>
