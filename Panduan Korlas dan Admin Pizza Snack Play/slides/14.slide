<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
        position: 'relative',
        overflow: 'hidden',
    }}
>
    <Box
        style={{
            position: 'absolute',
            top: -150,
            left: -120,
            width: 440,
            height: 440,
            borderRadius: 220,
            background: 'linear-gradient(135deg, #AFC440 0%, #F3B26C 100%)',
            opacity: 0.14,
        }}
    />

    {/* ── A · blok judul ── */}
    <Box style={{ height: 110, justifyContent: 'center' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#51277C',
                fontFamily: 'Trebuchet MS',
                lineHeight: 1.3,
            }}
        >
            Laporan piket: sudah merata?
        </Text>
        <Box style={{ marginTop: 10, width: 72, height: 6, borderRadius: 3, background: '#F3B26C' }} />
    </Box>

    {/* ── B · area konten ── */}
    <Box style={{ height: 530, flexDirection: 'row', gap: 34, position: 'relative', zIndex: 1 }}>
        {/* kiri 55% · frasa raksasa */}
        <Box style={{ width: '55%', height: '100%', justifyContent: 'center' }}>
            <Text
                style={{
                    fontSize: 62,
                    fontWeight: 'bold',
                    color: '#51277C',
                    fontFamily: 'Trebuchet MS',
                    lineHeight: 1.1,
                }}
            >
                Merata,{'\n'}bukan sekadar penuh.
            </Text>

            <Text
                style={{
                    marginTop: 22,
                    fontSize: 19,
                    color: '#2A2333',
                    fontFamily: 'Verdana',
                    lineHeight: 1.55,
                }}
            >
                Menu Laporan menghitung berapa kali setiap orang tua sudah mengambil piket,
                lengkap dengan tanggal dan menunya. Angkanya diambil dari tempat yang sama
                dengan yang dipakai orang tua saat mengambil tanggal.
            </Text>

            <Box
                style={{
                    marginTop: 24,
                    background: 'rgba(243,178,108,0.22)',
                    borderRadius: 14,
                    borderLeft: '8px solid #F3B26C',
                    padding: 18,
                }}
            >
                <Text
                    style={{
                        fontSize: 18,
                        color: '#2A2333',
                        fontFamily: 'Verdana',
                        lineHeight: 1.5,
                    }}
                >
                    Yang paling berguna justru satu daftar ini:
                </Text>
                <Text
                    style={{
                        marginTop: 10,
                        fontSize: 19,
                        fontWeight: 'bold',
                        color: '#51277C',
                        fontFamily: 'Trebuchet MS',
                        lineHeight: 1.35,
                    }}
                >
                    Belum pernah ambil
                </Text>
                <Text
                    style={{
                        marginTop: 4,
                        fontSize: 17,
                        color: '#2A2333',
                        fontFamily: 'Verdana',
                        lineHeight: 1.5,
                    }}
                >
                    merekalah yang bisa diajak lebih dulu bulan depan.
                </Text>
            </Box>
        </Box>

        {/* kanan 45% · rekap per orang tua */}
        <Box
            style={{
                width: '45%',
                height: '100%',
                background: 'rgba(81,39,124,0.06)',
                borderRadius: 20,
                justifyContent: 'center',
                alignItems: 'center',
            }}
        >
            <svg width={430} height={430} viewBox='0 0 430 430'>
                <text x='18' y='38' fontFamily='Trebuchet MS' fontSize='21' fontWeight='bold' fill='#51277C'>
                    Rekap ambil piket
                </text>
                <text x='18' y='62' fontFamily='Verdana' fontSize='14' fill='#6B6478'>
                    1 – 31 Oktober · Kelas 1
                </text>

                {/* Sari · 4 */}
                <text x='18' y='120' fontFamily='Verdana' fontSize='15' fill='#2A2333'>Sari</text>
                <rect x='110' y='104' width='250' height='22' rx='11' fill='#EFEAE1' />
                <rect x='110' y='104' width='250' height='22' rx='11' fill='#51277C' />
                <text x='372' y='120' fontFamily='Trebuchet MS' fontSize='16' fontWeight='bold' fill='#51277C'>4</text>

                {/* Budi · 3 */}
                <text x='18' y='176' fontFamily='Verdana' fontSize='15' fill='#2A2333'>Budi</text>
                <rect x='110' y='160' width='250' height='22' rx='11' fill='#EFEAE1' />
                <rect x='110' y='160' width='188' height='22' rx='11' fill='#51277C' />
                <text x='372' y='176' fontFamily='Trebuchet MS' fontSize='16' fontWeight='bold' fill='#51277C'>3</text>

                {/* Dewi · 2 */}
                <text x='18' y='232' fontFamily='Verdana' fontSize='15' fill='#2A2333'>Dewi</text>
                <rect x='110' y='216' width='250' height='22' rx='11' fill='#EFEAE1' />
                <rect x='110' y='216' width='125' height='22' rx='11' fill='#51277C' />
                <text x='372' y='232' fontFamily='Trebuchet MS' fontSize='16' fontWeight='bold' fill='#51277C'>2</text>

                {/* Rina · 1 */}
                <text x='18' y='288' fontFamily='Verdana' fontSize='15' fill='#2A2333'>Rina</text>
                <rect x='110' y='272' width='250' height='22' rx='11' fill='#EFEAE1' />
                <rect x='110' y='272' width='63' height='22' rx='11' fill='#51277C' />
                <text x='372' y='288' fontFamily='Trebuchet MS' fontSize='16' fontWeight='bold' fill='#51277C'>1</text>

                {/* Anto · 0 — belum pernah */}
                <text x='18' y='344' fontFamily='Verdana' fontSize='15' fill='#2A2333'>Anto</text>
                <rect x='110' y='328' width='250' height='22' rx='11' fill='#EFEAE1' />
                <rect x='110' y='328' width='250' height='22' rx='11' fill='#F3B26C' opacity='0.35' />
                <text x='372' y='344' fontFamily='Trebuchet MS' fontSize='16' fontWeight='bold' fill='#F3B26C'>0</text>

                {/* simpulan */}
                <rect x='18' y='374' width='394' height='48' rx='14' fill='#51277C' />
                <text x='38' y='396' fontFamily='Verdana' fontSize='15' fill='#F3B26C' fontWeight='bold'>
                    Belum pernah ambil: Anto
                </text>
                <text x='38' y='414' fontFamily='Verdana' fontSize='13' fill='#EFEAE1'>
                    ajak lebih dulu saat menyusun bulan depan
                </text>
            </svg>
        </Box>
    </Box>

    {/* ── C · bilah kaki ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>
            Pizza Snack Play · Panduan Korlas &amp; Admin
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>14 / 16</Text>
    </Box>
</Slide>
