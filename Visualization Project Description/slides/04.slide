<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        flexDirection: 'column',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
        position: 'relative',
    }}
>
    {/* ── zona A ── */}
    <Box style={{ height: 110, justifyContent: 'flex-start' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#2A2333',
                lineHeight: 1.3,
                fontFamily: 'Trebuchet MS',
            }}
        >
            136 lines was the whole system
        </Text>
        <Box style={{ width: 72, height: 6, background: '#51277C', marginTop: 12 }} />
    </Box>

    {/* ── zona B ── */}
    <Box style={{ height: 530, flexDirection: 'column', gap: 24 }}>
        {/* grafik */}
        <Box style={{ height: 250 }}>
            <svg width={1150} height={250} viewBox='0 0 1150 250'>
                <text
                    x='0'
                    y='20'
                    fontFamily='Trebuchet MS'
                    fontSize='16'
                    fontWeight='bold'
                    fill='#2A2333'
                >
                    Composition of the source artefact
                </text>
                <text x='0' y='42' fontFamily='Verdana' fontSize='13' fill='#6B6478'>
                    data/output_jadwal_piket.txt · 136 lines · 5 weekly blocks · classes 1–5
                </text>

                <rect x='0' y='64' width='727' height='68' fill='#51277C' />
                <rect x='727' y='64' width='177' height='68' fill='#7A45A8' />
                <rect x='904' y='64' width='43' height='68' fill='#F3B26C' />
                <rect x='947' y='64' width='203' height='68' fill='#D9D2E3' />

                <text
                    x='363'
                    y='107'
                    textAnchor='middle'
                    fontFamily='Verdana'
                    fontSize='16'
                    fontWeight='bold'
                    fill='#FFFFFF'
                >
                    86 duty assignments
                </text>
                <text
                    x='815'
                    y='107'
                    textAnchor='middle'
                    fontFamily='Verdana'
                    fontSize='14'
                    fontWeight='bold'
                    fill='#FFFFFF'
                >
                    21 menus
                </text>
                <text x='975' y='107' textAnchor='middle' fontFamily='Verdana' fontSize='13' fill='#6B6478'>
                    blanks
                </text>

                <rect x='0' y='158' width='13' height='13' fill='#51277C' />
                <text x='22' y='169' fontFamily='Verdana' fontSize='13' fill='#6B6478'>
                    86 duty assignment lines (63%)
                </text>
                <rect x='300' y='158' width='13' height='13' fill='#7A45A8' />
                <text x='322' y='169' fontFamily='Verdana' fontSize='13' fill='#6B6478'>
                    21 menu lines (15%)
                </text>
                <rect x='520' y='158' width='13' height='13' fill='#F3B26C' />
                <text x='542' y='169' fontFamily='Verdana' fontSize='13' fill='#6B6478'>
                    5 hand-written week headers (4%)
                </text>
                <rect x='830' y='158' width='13' height='13' fill='#D9D2E3' />
                <text x='852' y='169' fontFamily='Verdana' fontSize='13' fill='#6B6478'>
                    24 blank / separator lines (18%)
                </text>

                <text x='0' y='215' fontFamily='Verdana' fontSize='13' fill='#6B6478'>
                    Measured line by line. 38 unique student names appear in those 86 assignment
                    lines — and not one of them is linked to a parent record.
                </text>
            </svg>
        </Box>

        {/* dua kartu */}
        <Box style={{ height: 256, flexDirection: 'row', gap: 20 }}>
            <Box
                style={{
                    flex: 60,
                    background: '#FFFFFF',
                    borderRadius: 10,
                    paddingTop: 22,
                    paddingBottom: 22,
                    paddingLeft: 24,
                    paddingRight: 24,
                    boxShadow: '0 4px 20px rgba(0,0,0,0.08)',
                    borderTop: '3px solid #AFC440',
                    flexDirection: 'column',
                }}
            >
                <Text
                    style={{
                        fontSize: 20,
                        fontWeight: 'bold',
                        color: '#2A2333',
                        fontFamily: 'Trebuchet MS',
                    }}
                >
                    What the format could not do
                </Text>
                <Box style={{ flexDirection: 'row', gap: 12, marginTop: 18, alignItems: 'flex-start' }}>
                    <Box style={{ width: 6, height: 6, background: '#51277C', marginTop: 9 }} />
                    <Text style={{ fontSize: 16, color: '#6B6478', lineHeight: 1.5, flex: 1 }}>
                        No search — “when was jeruk served?” means reading all 21 menu lines
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, marginTop: 12, alignItems: 'flex-start' }}>
                    <Box style={{ width: 6, height: 6, background: '#51277C', marginTop: 9 }} />
                    <Text style={{ fontSize: 16, color: '#6B6478', lineHeight: 1.5, flex: 1 }}>
                        No history — the file is overwritten month to month
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, marginTop: 12, alignItems: 'flex-start' }}>
                    <Box style={{ width: 6, height: 6, background: '#51277C', marginTop: 9 }} />
                    <Text style={{ fontSize: 16, color: '#6B6478', lineHeight: 1.5, flex: 1 }}>
                        No duty identity — a name beside a class, with no parent record behind it
                    </Text>
                </Box>
            </Box>

            <Box
                style={{
                    flex: 40,
                    background: 'rgba(81,39,124,0.06)',
                    borderRadius: 10,
                    paddingTop: 22,
                    paddingBottom: 22,
                    paddingLeft: 24,
                    paddingRight: 24,
                    borderTop: '3px solid #F3B26C',
                    flexDirection: 'column',
                }}
            >
                <Text
                    style={{
                        fontSize: 20,
                        fontWeight: 'bold',
                        color: '#51277C',
                        fontFamily: 'Trebuchet MS',
                    }}
                >
                    The format caused it, not the school
                </Text>
                <Text style={{ fontSize: 16, color: '#6B6478', lineHeight: 1.5, marginTop: 16 }}>
                    Week headers are written by hand — and one was already wrong:
                    <span style={{ color: '#c4762a', fontWeight: 'bold' }}> 14 - 18 Oktober 2026</span>{' '}
                    was labelled Mon–Fri, although 14 October 2026 is a Wednesday.
                </Text>
                <Box
                    style={{
                        marginTop: 'auto',
                        flexDirection: 'row',
                        gap: 10,
                        alignItems: 'center',
                    }}
                >
                    <Box style={{ width: 6, height: 20, background: '#F3B26C' }} />
                    <Text style={{ fontSize: 15, color: '#51277C' }}>
                        A manual spreadsheet cannot catch that.
                    </Text>
                </Box>
            </Box>
        </Box>
    </Box>

    {/* ── zona C ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            justifyContent: 'space-between',
            alignItems: 'center',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478' }}>
            Pizza Snack Play · Visualization Project Description
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6478' }}>04 / 16</Text>
    </Box>
</Slide>
