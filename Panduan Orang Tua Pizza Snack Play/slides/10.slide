<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
    }}
>
    {/* ── A · blok judul ── */}
    <Box style={{ height: 110, justifyContent: 'center' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#51277C',
                fontFamily: 'Trebuchet MS',
                lineHeight: 1.3,
            }}
        >
            Lihat jadwal snack
        </Text>
        <Box style={{ marginTop: 10, width: 72, height: 6, borderRadius: 3, background: '#51277C' }} />
    </Box>

    {/* ── B · area konten ── */}
    <Box style={{ height: 530 }}>
        {/* atas 64% · ilustrasi jadwal sepekan */}
        <Box
            style={{
                height: 340,
                background: 'rgba(81,39,124,0.06)',
                borderRadius: 20,
                justifyContent: 'center',
                alignItems: 'center',
            }}
        >
            <svg width={1100} height={300} viewBox='0 0 1100 300'>
                {/* Senin */}
                <rect x='6' y='8' width='208' height='284' rx='16' fill='#FFFFFF' stroke='#E6DFD2' strokeWidth='2' />
                <rect x='6' y='8' width='208' height='58' rx='16' fill='#EFEAE1' />
                <rect x='6' y='44' width='208' height='22' fill='#EFEAE1' />
                <text x='110' y='46' fontFamily='Trebuchet MS' fontSize='24' fontWeight='bold' fill='#51277C' textAnchor='middle'>
                    Senin
                </text>
                <rect x='28' y='92' width='164' height='16' rx='8' fill='#DED7CB' />
                <rect x='28' y='124' width='128' height='14' rx='7' fill='#EDE8DF' />
                <rect x='28' y='158' width='72' height='28' rx='14' fill='#AFC440' />
                <text x='64' y='178' fontFamily='Verdana' fontSize='15' fill='#3F4718' textAnchor='middle'>
                    Jeruk
                </text>
                <rect x='28' y='214' width='164' height='1' fill='#EFEAE1' />
                <circle cx='44' cy='240' r='12' fill='#DED7CB' />
                <rect x='64' y='233' width='104' height='12' rx='6' fill='#EDE8DF' />

                {/* Selasa */}
                <rect x='226' y='8' width='208' height='284' rx='16' fill='#FFFFFF' stroke='#E6DFD2' strokeWidth='2' />
                <rect x='226' y='8' width='208' height='58' rx='16' fill='#EFEAE1' />
                <rect x='226' y='44' width='208' height='22' fill='#EFEAE1' />
                <text x='330' y='46' fontFamily='Trebuchet MS' fontSize='24' fontWeight='bold' fill='#51277C' textAnchor='middle'>
                    Selasa
                </text>
                <rect x='248' y='92' width='164' height='16' rx='8' fill='#DED7CB' />
                <rect x='248' y='124' width='112' height='14' rx='7' fill='#EDE8DF' />
                <rect x='248' y='158' width='72' height='28' rx='14' fill='#AFC440' />
                <text x='284' y='178' fontFamily='Verdana' fontSize='15' fill='#3F4718' textAnchor='middle'>
                    Pisang
                </text>
                <rect x='248' y='214' width='164' height='1' fill='#EFEAE1' />
                <circle cx='264' cy='240' r='12' fill='#DED7CB' />
                <rect x='284' y='233' width='96' height='12' rx='6' fill='#EDE8DF' />

                {/* Rabu — hari ini, disorot */}
                <rect x='446' y='0' width='208' height='300' rx='16' fill='#FFFFFF' stroke='#F3B26C' strokeWidth='5' />
                <rect x='446' y='0' width='208' height='62' rx='16' fill='#51277C' />
                <rect x='446' y='40' width='208' height='22' fill='#51277C' />
                <text x='550' y='42' fontFamily='Trebuchet MS' fontSize='24' fontWeight='bold' fill='#FFFFFF' textAnchor='middle'>
                    Rabu
                </text>
                <rect x='468' y='92' width='164' height='16' rx='8' fill='#51277C' opacity='0.65' />
                <rect x='468' y='124' width='136' height='14' rx='7' fill='#EDE8DF' />
                <rect x='468' y='158' width='92' height='28' rx='14' fill='#F3B26C' />
                <text x='514' y='178' fontFamily='Verdana' fontSize='15' fill='#51277C' textAnchor='middle'>
                    Semangka
                </text>
                <rect x='468' y='214' width='164' height='1' fill='#EFEAE1' />
                <circle cx='484' cy='240' r='12' fill='#51277C' opacity='0.25' />
                <rect x='504' y='233' width='118' height='12' rx='6' fill='#DED7CB' />
                <circle cx='654' cy='16' r='13' fill='#F3B26C' />
                <text x='654' y='22' fontFamily='Verdana' fontSize='13' fontWeight='bold' fill='#51277C' textAnchor='middle'>
                    !
                </text>

                {/* Kamis */}
                <rect x='666' y='8' width='208' height='284' rx='16' fill='#FFFFFF' stroke='#E6DFD2' strokeWidth='2' />
                <rect x='666' y='8' width='208' height='58' rx='16' fill='#EFEAE1' />
                <rect x='666' y='44' width='208' height='22' fill='#EFEAE1' />
                <text x='770' y='46' fontFamily='Trebuchet MS' fontSize='24' fontWeight='bold' fill='#51277C' textAnchor='middle'>
                    Kamis
                </text>
                <rect x='688' y='92' width='164' height='16' rx='8' fill='#DED7CB' />
                <rect x='688' y='124' width='120' height='14' rx='7' fill='#EDE8DF' />
                <rect x='688' y='158' width='64' height='28' rx='14' fill='#AFC440' />
                <text x='720' y='178' fontFamily='Verdana' fontSize='15' fill='#3F4718' textAnchor='middle'>
                    Apel
                </text>
                <rect x='688' y='214' width='164' height='1' fill='#EFEAE1' />
                <circle cx='704' cy='240' r='12' fill='#DED7CB' />
                <rect x='724' y='233' width='88' height='12' rx='6' fill='#EDE8DF' />

                {/* Jumat */}
                <rect x='886' y='8' width='208' height='284' rx='16' fill='#FFFFFF' stroke='#E6DFD2' strokeWidth='2' />
                <rect x='886' y='8' width='208' height='58' rx='16' fill='#EFEAE1' />
                <rect x='886' y='44' width='208' height='22' fill='#EFEAE1' />
                <text x='990' y='46' fontFamily='Trebuchet MS' fontSize='24' fontWeight='bold' fill='#51277C' textAnchor='middle'>
                    Jumat
                </text>
                <rect x='908' y='92' width='164' height='16' rx='8' fill='#DED7CB' />
                <rect x='908' y='124' width='132' height='14' rx='7' fill='#EDE8DF' />
                <rect x='908' y='158' width='70' height='28' rx='14' fill='#AFC440' />
                <text x='943' y='178' fontFamily='Verdana' fontSize='15' fill='#3F4718' textAnchor='middle'>
                    Melon
                </text>
                <rect x='908' y='214' width='164' height='1' fill='#EFEAE1' />
                <circle cx='924' cy='240' r='12' fill='#DED7CB' />
                <rect x='944' y='233' width='106' height='12' rx='6' fill='#EDE8DF' />
            </svg>
        </Box>

        {/* bawah · dua kartu 60:40 */}
        <Box style={{ marginTop: 18, height: 172, flexDirection: 'row', gap: 24 }}>
            <Box
                style={{
                    width: '60%',
                    background: '#FFFFFF',
                    borderRadius: 16,
                    boxShadow: '0 4px 20px rgba(0,0,0,0.08)',
                    padding: 24,
                    borderLeft: '8px solid #F3B26C',
                }}
            >
                <Text
                    style={{
                        fontSize: 26,
                        fontWeight: 'bold',
                        color: '#51277C',
                        fontFamily: 'Trebuchet MS',
                    }}
                >
                    Hari ini &amp; minggu ini
                </Text>
                <Text
                    style={{
                        marginTop: 10,
                        fontSize: 19,
                        color: '#6B6478',
                        fontFamily: 'Verdana',
                        lineHeight: 1.5,
                    }}
                >
                    Begitu aplikasi dibuka, makanan dan buahnya langsung kelihatan. Hari yang sedang berjalan ditandai, jadi tidak salah lihat.
                </Text>
            </Box>

            <Box
                style={{
                    width: '40%',
                    background: '#FFFFFF',
                    borderRadius: 16,
                    boxShadow: '0 4px 20px rgba(0,0,0,0.08)',
                    padding: 24,
                    borderLeft: '8px solid #AFC440',
                }}
            >
                <Text
                    style={{
                        fontSize: 26,
                        fontWeight: 'bold',
                        color: '#51277C',
                        fontFamily: 'Trebuchet MS',
                    }}
                >
                    Bulan ini
                </Text>
                <Text
                    style={{
                        marginTop: 10,
                        fontSize: 19,
                        color: '#6B6478',
                        fontFamily: 'Verdana',
                        lineHeight: 1.5,
                    }}
                >
                    Kalender penuh satu bulan — bisa melihat jadwal jauh hari sebelumnya.
                </Text>
            </Box>
        </Box>
    </Box>

    {/* ── C · bilah kaki ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>
            Pizza Snack Play · Panduan Orang Tua
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>10 / 15</Text>
    </Box>
</Slide>
