<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        flexDirection: 'column',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
        position: 'relative',
    }}
>
    {/* ── zona A ── */}
    <Box style={{ height: 110, justifyContent: 'flex-start' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#2A2333',
                lineHeight: 1.3,
                fontFamily: 'Trebuchet MS',
            }}
        >
            draft → locked → published
        </Text>
        <Box style={{ width: 72, height: 6, background: '#51277C', marginTop: 12 }} />
    </Box>

    {/* ── zona B ── */}
    <Box style={{ height: 530, flexDirection: 'row', gap: 20 }}>
        {/* kiri: tiga aturan */}
        <Box style={{ flex: 40, flexDirection: 'column', gap: 12 }}>
            <Box
                style={{
                    background: '#FFFFFF',
                    borderRadius: 10,
                    paddingTop: 18,
                    paddingBottom: 18,
                    paddingLeft: 20,
                    paddingRight: 20,
                    boxShadow: '0 4px 20px rgba(0,0,0,0.08)',
                    borderTop: '3px solid #F3B26C',
                    flexDirection: 'column',
                }}
            >
                <Text
                    style={{
                        fontSize: 17,
                        fontWeight: 'bold',
                        color: '#c4762a',
                        fontFamily: 'Trebuchet MS',
                    }}
                >
                    The rule that matters most
                </Text>
                <Text style={{ fontSize: 15, color: '#6B6478', lineHeight: 1.5, marginTop: 8 }}>
                    Publishing refuses with 409 drafts_remaining when any row is still a draft — and
                    names the offending classes. A half-published class is structurally impossible.
                </Text>
            </Box>

            <Box
                style={{
                    background: '#FFFFFF',
                    borderRadius: 10,
                    paddingTop: 18,
                    paddingBottom: 18,
                    paddingLeft: 20,
                    paddingRight: 20,
                    boxShadow: '0 4px 20px rgba(0,0,0,0.08)',
                    borderTop: '3px solid #F3B26C',
                    flexDirection: 'column',
                }}
            >
                <Text
                    style={{
                        fontSize: 17,
                        fontWeight: 'bold',
                        color: '#c4762a',
                        fontFamily: 'Trebuchet MS',
                    }}
                >
                    The one deliberate exception
                </Text>
                <Text style={{ fontSize: 15, color: '#6B6478', lineHeight: 1.5, marginTop: 8 }}>
                    On a locked row the duty officer alone may still be set — duty is often filled
                    after announcement. A mixed patch is still refused.
                </Text>
            </Box>

            <Box
                style={{
                    background: '#FFFFFF',
                    borderRadius: 10,
                    paddingTop: 18,
                    paddingBottom: 18,
                    paddingLeft: 20,
                    paddingRight: 20,
                    boxShadow: '0 4px 20px rgba(0,0,0,0.08)',
                    borderTop: '3px solid #51277C',
                    flexDirection: 'column',
                }}
            >
                <Text
                    style={{
                        fontSize: 17,
                        fontWeight: 'bold',
                        color: '#51277C',
                        fontFamily: 'Trebuchet MS',
                    }}
                >
                    Two bulk semantics, kept different
                </Text>
                <Text style={{ fontSize: 15, color: '#6B6478', lineHeight: 1.5, marginTop: 8 }}>
                    Range operations fail loudly with 409. Selected-row operations skip and report —
                    because ticking rows is an explicit choice.
                </Text>
            </Box>
        </Box>

        {/* kanan: mesin status */}
        <Box
            style={{
                flex: 60,
                background: '#FFFFFF',
                borderRadius: 10,
                padding: 22,
                boxShadow: '0 4px 20px rgba(0,0,0,0.08)',
                borderTop: '3px solid #AFC440',
                justifyContent: 'center',
                alignItems: 'center',
            }}
        >
            <svg width={620} height={420} viewBox='0 0 620 420'>
                <text
                    x='0'
                    y='18'
                    fontFamily='Trebuchet MS'
                    fontSize='16'
                    fontWeight='bold'
                    fill='#2A2333'
                >
                    The schedule lifecycle
                </text>
                <text x='0' y='40' fontFamily='Verdana' fontSize='12' fill='#6B6478'>
                    Every row starts in draft. Publication is the only way out.
                </text>

                <rect x='0' y='66' width='170' height='80' rx='8' fill='#FFFFFF' stroke='#51277C' strokeWidth='1.6' />
                <text
                    x='85'
                    y='104'
                    textAnchor='middle'
                    fontFamily='Trebuchet MS'
                    fontSize='20'
                    fontWeight='bold'
                    fill='#51277C'
                >
                    draft
                </text>
                <text x='85' y='128' textAnchor='middle' fontFamily='Verdana' fontSize='12' fill='#6B6478'>
                    fully editable
                </text>

                <rect x='225' y='66' width='170' height='80' rx='8' fill='#FFFFFF' stroke='#51277C' strokeWidth='1.6' />
                <text
                    x='310'
                    y='104'
                    textAnchor='middle'
                    fontFamily='Trebuchet MS'
                    fontSize='20'
                    fontWeight='bold'
                    fill='#51277C'
                >
                    locked
                </text>
                <text x='310' y='128' textAnchor='middle' fontFamily='Verdana' fontSize='12' fill='#6B6478'>
                    frozen
                </text>

                <rect x='450' y='66' width='170' height='80' rx='8' fill='#F3B26C' stroke='#d97f2f' strokeWidth='1.6' />
                <text
                    x='535'
                    y='104'
                    textAnchor='middle'
                    fontFamily='Trebuchet MS'
                    fontSize='20'
                    fontWeight='bold'
                    fill='#3c1e0c'
                >
                    published
                </text>
                <text x='535' y='128' textAnchor='middle' fontFamily='Verdana' fontSize='12' fill='#6f3c1c'>
                    visible to parents
                </text>

                <line x1='174' y1='106' x2='221' y2='106' stroke='#51277C' strokeWidth='1.6' />
                <polygon points='221,106 213,101 213,111' fill='#51277C' />
                <text x='197' y='94' textAnchor='middle' fontFamily='Verdana' fontSize='12' fontWeight='bold' fill='#6B6478'>
                    lock
                </text>

                <line x1='399' y1='106' x2='446' y2='106' stroke='#51277C' strokeWidth='1.6' />
                <polygon points='446,106 438,101 438,111' fill='#51277C' />
                <text x='422' y='94' textAnchor='middle' fontFamily='Verdana' fontSize='12' fontWeight='bold' fill='#6B6478'>
                    publish
                </text>

                <path
                    d='M535 150 L535 196 L85 196 L85 150'
                    fill='none'
                    stroke='#F3B26C'
                    strokeWidth='1.6'
                    strokeDasharray='6 4'
                />
                <polygon points='85,150 80,159 90,159' fill='#F3B26C' />
                <text
                    x='310'
                    y='216'
                    textAnchor='middle'
                    fontFamily='Verdana'
                    fontSize='12'
                    fontWeight='bold'
                    fill='#c4762a'
                >
                    unlock — admin only
                </text>

                <line x1='0' y1='246' x2='620' y2='246' stroke='rgba(81,39,124,0.18)' />

                <text x='0' y='278' fontFamily='Verdana' fontSize='13' fill='#6B6478'>
                    publish → 409 drafts_remaining, offending classes named
                </text>
                <text x='0' y='306' fontFamily='Verdana' fontSize='13' fill='#6B6478'>
                    PUT / DELETE on a locked row → 409 not_editable
                </text>
                <text x='0' y='334' fontFamily='Verdana' fontSize='13' fill='#6B6478'>
                    exception: the duty officer alone may still be set
                </text>
                <text x='0' y='362' fontFamily='Verdana' fontSize='13' fill='#6B6478'>
                    the status predicate lives in the SQL WHERE clause
                </text>
                <text x='0' y='396' fontFamily='Verdana' fontSize='13' fontWeight='bold' fill='#51277C'>
                    Set by setStatusByIds() — not by the caller.
                </text>
            </svg>
        </Box>
    </Box>

    {/* ── zona C ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            justifyContent: 'space-between',
            alignItems: 'center',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478' }}>
            Pizza Snack Play · Visualization Project Description
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6478' }}>09 / 16</Text>
    </Box>
</Slide>
