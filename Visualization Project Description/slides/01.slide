            height: 360,
            borderRadius: 180,
            background: 'linear-gradient(135deg, #AFC440 0%, #F3B26C 100%)',
            opacity: 0.14,
        }}
    />

    {/* ── kolom kiri ── */}
    <Box
        style={{
            position: 'relative',
            zIndex: 1,
            width: '58%',
            paddingTop: 92,
            paddingBottom: 92,
            paddingLeft: 64,
            paddingRight: 28,
            justifyContent: 'center',
        }}
    >
        <Box
            style={{
                flexDirection: 'row',
