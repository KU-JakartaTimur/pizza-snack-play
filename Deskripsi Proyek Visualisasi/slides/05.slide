<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        flexDirection: 'column',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
        position: 'relative',
    }}
>
    {/* ── zona A ── */}
    <Box style={{ height: 110, justifyContent: 'flex-start' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#2A2333',
                lineHeight: 1.3,
                fontFamily: 'Trebuchet MS',
            }}
        >Delapan momen dalam pekan sekolah</Text>
        <Box style={{ width: 72, height: 6, background: '#51277C', marginTop: 12 }} />
    </Box>

    {/* ── zona B ── */}
    <Box style={{ height: 530, flexDirection: 'row', gap: 20 }}>
        {/* kolom lebar: delapan skenario */}
        <Box style={{ flex: 60, flexDirection: 'column', gap: 12 }}>
            <Box style={{ flexDirection: 'row', gap: 24 }}>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#c4762a', letterSpacing: 1 }}>S1 · SETIAP PAGI</Text>
                    <Text
                        style={{
                            fontSize: 17,
                            fontWeight: 'bold',
                            color: '#2A2333',
                            marginTop: 5,
                            fontFamily: 'Trebuchet MS',
                        }}
                    >Snack hari ini</Text>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 6 }}>Satu layar, lengkap dengan tautan WhatsApp wali petugas di samping menunya.</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#c4762a', letterSpacing: 1 }}>S2 · MINGGU MALAM</Text>
                    <Text
                        style={{
                            fontSize: 17,
                            fontWeight: 'bold',
                            color: '#2A2333',
                            marginTop: 5,
                            fontFamily: 'Trebuchet MS',
                        }}
                    >Rencana sepekan</Text>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 6 }}>Menu dan daftar piket dulu dibaca dari dua tempat; kini satu tampilan, Senin–Jumat.</Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row', gap: 24 }}>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#c4762a', letterSpacing: 1 }}>S3 · SAAT KELAS KENA PIKET</Text>
                    <Text
                        style={{
                            fontSize: 17,
                            fontWeight: 'bold',
                            color: '#2A2333',
                            marginTop: 5,
                            fontFamily: 'Trebuchet MS',
                        }}
                    >Rotasi piket</Text>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 6 }}>Petugas adalah relasi bertipe, dipilih dari roster kelas itu sendiri.</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#c4762a', letterSpacing: 1 }}>S4 · SAAT TANGGAL MASIH KOSONG</Text>
                    <Text
                        style={{
                            fontSize: 17,
                            fontWeight: 'bold',
                            color: '#2A2333',
                            marginTop: 5,
                            fontFamily: 'Trebuchet MS',
                        }}
                    >Mengambil tanggal</Text>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 6 }}>Orang tua mengambilnya sendiri — aman dari rebutan di level basis data.</Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row', gap: 24 }}>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#c4762a', letterSpacing: 1 }}>S5 · SEBULAN SEKALI</Text>
                    <Text
                        style={{
                            fontSize: 17,
                            fontWeight: 'bold',
                            color: '#2A2333',
                            marginTop: 5,
                            fontFamily: 'Trebuchet MS',
                        }}
                    >Kunci dan terbitkan</Text>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 6 }}>Mesin tiga status menggantikan “berkasnya sudah dikirim atau belum”.</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#c4762a', letterSpacing: 1 }}>S6 · RAPAT BULANAN</Text>
                    <Text
                        style={{
                            fontSize: 17,
                            fontWeight: 'bold',
                            color: '#2A2333',
                            marginTop: 5,
                            fontFamily: 'Trebuchet MS',
                        }}
                    >Sudah meratakah beban piketnya?</Text>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 6 }}>Laporannya memeringkat setiap orang tua dan menyebut yang belum pernah ambil.</Text>
                </Box>
            </Box>

            <Box style={{ flexDirection: 'row', gap: 24 }}>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#c4762a', letterSpacing: 1 }}>S7 · MENYUSUN BULAN DEPAN</Text>
                    <Text
                        style={{
                            fontSize: 17,
                            fontWeight: 'bold',
                            color: '#2A2333',
                            marginTop: 5,
                            fontFamily: 'Trebuchet MS',
                        }}
                    >Pakai ulang menu dan riwayat</Text>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 6 }}>Katalog 43 menu dan 85 item yang bisa dicari, dipakai bersama semua kelas.</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#c4762a', letterSpacing: 1 }}>S8 · SETIAP TAHUN AJARAN</Text>
                    <Text
                        style={{
                            fontSize: 17,
                            fontWeight: 'bold',
                            color: '#2A2333',
                            marginTop: 5,
                            fontFamily: 'Trebuchet MS',
                        }}
                    >Siklus hidup akun</Text>
                    <Text style={{ fontSize: 14, color: '#6B6478', lineHeight: 1.45, marginTop: 6 }}>Bolak-balik Excel: ekspor, sunting, impor — selalu lewat pratinjau.</Text>
                </Box>
            </Box>
        </Box>

        {/* kolom sempit: pasangan penentu arsitektur */}
        <Box
            style={{
                flex: 40,
                background: 'linear-gradient(135deg, #51277C 0%, #7A45A8 100%)',
                borderRadius: 10,
                paddingTop: 26,
                paddingBottom: 26,
                paddingLeft: 26,
                paddingRight: 26,
                flexDirection: 'column',
            }}
        >
            <Text style={{ fontSize: 12, fontWeight: 'bold', color: '#AFC440', letterSpacing: 1.4 }}>PASANGAN YANG MENENTUKAN</Text>
            <Text
                style={{
                    fontSize: 24,
                    fontWeight: 'bold',
                    color: '#FFFFFF',
                    lineHeight: 1.3,
                    marginTop: 12,
                    fontFamily: 'Trebuchet MS',
                }}
            >S4 + S5, bersama</Text>
            <Box style={{ width: 56, height: 5, background: '#AFC440', marginTop: 16 }} />
            <Text
                style={{
                    fontSize: 16,
                    color: 'rgba(255,255,255,0.88)',
                    lineHeight: 1.6,
                    marginTop: 18,
                }}
            >Klaim menulis balik ke baris jadwal. Publikasi membekukan baris. Kalau keduanya bebas menulis, orang tua bisa mengambil slot di bulan yang sudah diumumkan sekolah.</Text>
            <Box style={{ marginTop: 'auto', flexDirection: 'row', gap: 10, alignItems: 'center' }}>
                <Box style={{ width: 6, height: 20, background: '#F3B26C' }} />
                <Text style={{ fontSize: 15, color: '#F3B26C', fontWeight: 'bold' }}>Mesin status membuat itu mustahil.</Text>
            </Box>
        </Box>
    </Box>

    {/* ── zona C ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            justifyContent: 'space-between',
            alignItems: 'center',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478' }}>Pizza Snack Play · Deskripsi Proyek Visualisasi</Text>
        <Text style={{ fontSize: 14, color: '#6B6478' }}>05 / 16</Text>
    </Box>
</Slide>
