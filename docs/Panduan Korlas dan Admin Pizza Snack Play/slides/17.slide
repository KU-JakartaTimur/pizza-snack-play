<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
    }}
>
    {/* ── A · blok judul ── */}
    <Box style={{ height: 110, justifyContent: 'center' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#51277C',
                fontFamily: 'Trebuchet MS',
                lineHeight: 1.3,
            }}
        >
            Mengabari orang tua lewat WhatsApp
        </Text>
        <Box style={{ marginTop: 10, width: 72, height: 6, borderRadius: 3, background: '#AFC440' }} />
    </Box>

    {/* ── B · area konten ── */}
    <Box style={{ height: 530, flexDirection: 'row', gap: 26 }}>
        {/* kiri 55% · tiruan kartu Notifikasi WhatsApp di Dashboard */}
        <Box
            style={{
                width: '55%',
                height: '100%',
                background: '#FFFFFF',
                borderRadius: 18,
                boxShadow: '0 4px 20px rgba(0,0,0,0.08)',
                borderTop: '8px solid #AFC440',
                padding: 22,
            }}
        >
            {/* kepala kartu */}
            <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
                <Text
                    style={{
                        fontSize: 22,
                        fontWeight: 'bold',
                        color: '#51277C',
                        fontFamily: 'Trebuchet MS',
                        lineHeight: 1.3,
                    }}
                >
                    Notifikasi WhatsApp
                </Text>
                <Box
                    style={{
                        flexDirection: 'row',
                        alignItems: 'center',
                        gap: 6,
                        paddingLeft: 12,
                        paddingRight: 12,
                        paddingTop: 5,
                        paddingBottom: 5,
                        borderRadius: 12,
                        background: 'rgba(175,196,64,0.18)',
                    }}
                >
                    <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#8FA32E' }} />
                    <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#5E6B1E', fontFamily: 'Verdana' }}>
                        Aktif
                    </Text>
                </Box>
            </Box>
            <Text
                style={{
                    marginTop: 4,
                    fontSize: 14,
                    color: '#6B6478',
                    fontFamily: 'Verdana',
                    lineHeight: 1.4,
                }}
            >
                Nomor sekolah sudah tersambung
            </Text>

            {/* dua tab */}
            <Box style={{ marginTop: 14, flexDirection: 'row', gap: 8 }}>
                <Box
                    style={{
                        paddingLeft: 16,
                        paddingRight: 16,
                        paddingTop: 8,
                        paddingBottom: 8,
                        borderRadius: 10,
                        background: 'rgba(81,39,124,0.10)',
                    }}
                >
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#51277C', fontFamily: 'Verdana' }}>
                        Broadcast
                    </Text>
                </Box>
                <Box
                    style={{
                        paddingLeft: 16,
                        paddingRight: 16,
                        paddingTop: 8,
                        paddingBottom: 8,
                        borderRadius: 10,
                        background: '#51277C',
                    }}
                >
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Verdana' }}>
                        Pengingat piket
                    </Text>
                </Box>
            </Box>

            {/* baris tanggal */}
            <Box style={{ marginTop: 14, flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>Tanggal</Text>
                <Box
                    style={{
                        flex: 1,
                        height: 38,
                        borderRadius: 10,
                        border: '1px solid #E3DCD2',
                        justifyContent: 'center',
                        paddingLeft: 12,
                    }}
                >
                    <Text style={{ fontSize: 15, color: '#2A2333', fontFamily: 'Verdana' }}>
                        1 September 2026
                    </Text>
                </Box>
                <Box
                    style={{
                        height: 38,
                        paddingLeft: 14,
                        paddingRight: 14,
                        borderRadius: 10,
                        background: '#51277C',
                        justifyContent: 'center',
                    }}
                >
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Verdana' }}>
                        Kirim
                    </Text>
                </Box>
            </Box>

            {/* pratinjau pesan */}
            <Box
                style={{
                    marginTop: 14,
                    height: 168,
                    background: 'rgba(175,196,64,0.10)',
                    borderRadius: 14,
                    borderLeft: '5px solid #AFC440',
                    padding: 14,
                }}
            >
                <Text style={{ fontSize: 13, color: '#6B6478', fontFamily: 'Verdana', lineHeight: 1.4 }}>
                    Pesan yang akan terkirim
                </Text>
                <Text
                    style={{
                        marginTop: 8,
                        fontSize: 15,
                        color: '#2A2333',
                        fontFamily: 'Verdana',
                        lineHeight: 1.5,
                    }}
                >
                    Assalamualaikum Bu Ani, Ani bertugas membawa snack pada Selasa, 1 September 2026
                    (Roti Abon + Susu). Terima kasih.
                </Text>
            </Box>

            {/* hasil kirim */}
            <Box style={{ marginTop: 14, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#51277C', fontFamily: 'Verdana' }}>
                    1 terkirim · 0 gagal
                </Text>
                <Text style={{ fontSize: 13, color: '#6B6478', fontFamily: 'Verdana' }}>
                    tersimpan di riwayat
                </Text>
            </Box>

            {/* riwayat singkat */}
            <Box style={{ marginTop: 16, height: 1, background: '#EFEAE1' }} />
            <Text style={{ marginTop: 12, fontSize: 13, color: '#6B6478', fontFamily: 'Verdana' }}>
                Riwayat
            </Text>
            <Box style={{ marginTop: 8, flexDirection: 'row', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 13, color: '#2A2333', fontFamily: 'Verdana' }}>
                    1 Sep 2026 · 1 terkirim
                </Text>
                <Text style={{ fontSize: 13, color: '#5E6B1E', fontFamily: 'Verdana' }}>selesai</Text>
            </Box>
            <Box style={{ marginTop: 7, flexDirection: 'row', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 13, color: '#2A2333', fontFamily: 'Verdana' }}>
                    30 Agu 2026 · gagal
                </Text>
                <Text style={{ fontSize: 13, color: '#A8452C', fontFamily: 'Verdana' }}>
                    nomor tidak terdaftar
                </Text>
            </Box>
        </Box>

        {/* kanan 45% · empat hal yang perlu diketahui */}
        <Box style={{ width: '45%', height: '100%', justifyContent: 'space-between' }}>
            {[
                {
                    t: 'Pilih tanggal, tekan Kirim',
                    d: 'Pengingat berangkat ke wali petugas pada tanggal itu. Bawaannya besok — biasanya tinggal satu tekan.',
                },
                {
                    t: 'Kelas Anda sendiri',
                    d: 'Korlas hanya bisa mengirim untuk kelasnya. Admin boleh memilih semua kelas sekaligus.',
                },
                {
                    t: 'Konfirmasi berjalan sendiri',
                    d: 'Begitu orang tua mengambil tanggal, wali langsung menerima konfirmasi — Anda tidak perlu mengabari lagi.',
                },
                {
                    t: 'Kalau gagal, alasannya tertulis',
                    d: 'Riwayat menyimpan sebabnya, misalnya nomor wali belum terdaftar di WhatsApp.',
                },
            ].map((it, i) => (
                <Box
                    key={i}
                    style={{
                        flex: 1,
                        background: 'rgba(81,39,124,0.06)',
                        borderRadius: 14,
                        borderLeft: '6px solid #F3B26C',
                        paddingTop: 12,
                        paddingBottom: 12,
                        paddingLeft: 16,
                        paddingRight: 16,
                    }}
                >
                    <Text
                        style={{
                            fontSize: 19,
                            fontWeight: 'bold',
                            color: '#51277C',
                            fontFamily: 'Trebuchet MS',
                            lineHeight: 1.3,
                        }}
                    >
                        {it.t}
                    </Text>
                    <Text
                        style={{
                            marginTop: 5,
                            fontSize: 15,
                            color: '#2A2333',
                            fontFamily: 'Verdana',
                            lineHeight: 1.45,
                        }}
                    >
                        {it.d}
                    </Text>
                </Box>
            ))}
        </Box>
    </Box>

    {/* ── C · bilah kaki ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>
            Pizza Snack Play · Panduan Korlas &amp; Admin
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>17 / 19</Text>
    </Box>
</Slide>
