<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
    }}
>
    {/* ── A · blok judul ── */}
    <Box style={{ height: 110, justifyContent: 'center' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#51277C',
                fontFamily: 'Trebuchet MS',
                lineHeight: 1.3,
            }}
        >
            Sekarang: cukup satu aplikasi
        </Text>
        <Box style={{ marginTop: 10, width: 72, height: 6, borderRadius: 3, background: '#51277C' }} />
    </Box>

    {/* ── B · area konten ── */}
    <Box style={{ height: 530, flexDirection: 'row', gap: 28 }}>
        {/* ── kiri 44% · teks ── */}
        <Box
            style={{
                width: '44%',
                justifyContent: 'center',
            }}
        >
        <Box
            style={{
                flexDirection: 'row',
                alignItems: 'center',
                gap: 10,
                alignSelf: 'flex-start',
                background: 'rgba(175,196,64,0.28)',
                borderRadius: 999,
                paddingTop: 8,
                paddingBottom: 8,
                paddingLeft: 18,
                paddingRight: 20,
            }}
        >
            <Text style={{ fontSize: 16, color: '#4F5A24', fontFamily: 'Verdana', fontWeight: 'bold' }}>
                Solusinya
            </Text>
        </Box>

        <Text
            style={{
                marginTop: 18,
                fontSize: 46,
                fontWeight: 'bold',
                color: '#51277C',
                fontFamily: 'Trebuchet MS',
                lineHeight: 1.15,
            }}
        >
            Menu jelas,{'\n'}giliran jelas.
        </Text>

        <Text
            style={{
                marginTop: 16,
                fontSize: 21,
                color: '#2A2333',
                fontFamily: 'Verdana',
                lineHeight: 1.5,
            }}
        >
            Tidak perlu tanya-tanya lagi ke grup.
        </Text>

        <Box style={{ marginTop: 22, gap: 14 }}>
            {[
                'Jadwal snack kelihatan kapan saja',
                'Giliran piket anak tercatat rapi',
                'Tanggal kosong bisa diambil sendiri',
            ].map((t, i) => (
                <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
                    <Box
                        style={{
                            width: 34,
                            height: 34,
                            borderRadius: 17,
                            background: '#AFC440',
                            justifyContent: 'center',
                            alignItems: 'center',
                        }}
                    >
                        <FAIcon name='check' style={{ fill: '#FFFFFF', width: 18, height: 18 }} />
                    </Box>
                    <Text style={{ fontSize: 20, color: '#2A2333', fontFamily: 'Verdana' }}>{t}</Text>
                </Box>
            ))}
        </Box>

        <Box
            style={{
                marginTop: 24,
                alignSelf: 'flex-start',
                background: '#F3B26C',
                borderRadius: 14,
                paddingTop: 13,
                paddingBottom: 13,
                paddingLeft: 24,
                paddingRight: 26,
            }}
        >
            <Text style={{ fontSize: 19, color: '#51277C', fontFamily: 'Trebuchet MS', fontWeight: 'bold' }}>
                Satu tempat. Satu rujukan.
            </Text>
        </Box>
    </Box>

    {/* ── kanan 52% · panel ungu + ponsel ── */}
    <Box
        style={{
            width: '52%',
            height: '100%',
            background: 'linear-gradient(135deg, #51277C 0%, #7A45A8 100%)',
            borderRadius: 20,
            justifyContent: 'center',
            alignItems: 'center',
            position: 'relative',
            overflow: 'hidden',
        }}
    >
        <Box
            style={{
                position: 'absolute',
                top: -110,
                left: -90,
                width: 340,
                height: 340,
                borderRadius: 170,
                background: '#AFC440',
                opacity: 0.16,
            }}
        />
        <Box style={{ position: 'relative', zIndex: 1 }}>
            <svg width={376} height={490} viewBox='0 0 430 560'>
                {/* bingkai ponsel */}
                <rect x='12' y='10' width='406' height='540' rx='46' fill='#FFFFFF' stroke='#E3DCCF' strokeWidth='4' />
                <rect x='176' y='26' width='78' height='11' rx='6' fill='#DCD5C9' />

                {/* bilah atas aplikasi */}
                <rect x='38' y='56' width='354' height='62' rx='14' fill='#51277C' />
                <text x='60' y='96' fontFamily='Trebuchet MS' fontSize='25' fontWeight='bold' fill='#FFFFFF'>
                    Hari Ini
                </text>
                <circle cx='366' cy='87' r='16' fill='#F3B26C' />

                {/* kartu menu hari ini */}
                <rect x='38' y='136' width='354' height='128' rx='16' fill='#F7F3EC' stroke='#E6DFD2' strokeWidth='2' />
                <rect x='60' y='158' width='92' height='26' rx='13' fill='#AFC440' />
                <text x='74' y='177' fontFamily='Verdana' fontSize='15' fill='#3F4718'>
                    Selasa
                </text>
                <text x='60' y='218' fontFamily='Trebuchet MS' fontSize='26' fontWeight='bold' fill='#2A2333'>
                    Roti coklat
                </text>
                <text x='60' y='246' fontFamily='Verdana' fontSize='19' fill='#6B6478'>
                    + Jeruk manis
                </text>

                {/* kartu minggu ini */}
                <rect x='38' y='280' width='354' height='166' rx='16' fill='#F7F3EC' stroke='#E6DFD2' strokeWidth='2' />
                <text x='60' y='310' fontFamily='Trebuchet MS' fontSize='21' fontWeight='bold' fill='#51277C'>
                    Minggu ini
                </text>
                <rect x='60' y='326' width='310' height='1' fill='#E6DFD2' />
                <circle cx='74' cy='352' r='7' fill='#AFC440' />
                <rect x='92' y='344' width='150' height='11' rx='5' fill='#C9C1B4' />
                <circle cx='74' cy='382' r='7' fill='#AFC440' />
                <rect x='92' y='374' width='120' height='11' rx='5' fill='#DED7CB' />
                <circle cx='74' cy='412' r='7' fill='#F3B26C' />
                <rect x='92' y='404' width='160' height='11' rx='5' fill='#DED7CB' />

                {/* bilah navigasi bawah */}
                <rect x='52' y='470' width='326' height='60' rx='30' fill='#FFFFFF' stroke='#E6DFD2' strokeWidth='2' />
                <circle cx='100' cy='500' r='11' fill='#51277C' />
                <circle cx='160' cy='500' r='11' fill='#DED7CB' />
                <circle cx='270' cy='500' r='11' fill='#DED7CB' />
                <circle cx='330' cy='500' r='11' fill='#DED7CB' />
                <circle cx='215' cy='470' r='24' fill='#51277C' />
                <rect x='203' y='459' width='24' height='4' rx='2' fill='#FFFFFF' />
                <rect x='203' y='467' width='24' height='4' rx='2' fill='#FFFFFF' />
                <rect x='203' y='475' width='24' height='4' rx='2' fill='#FFFFFF' />
            </svg>
        </Box>
    </Box>
    </Box>

    {/* ── C · bilah kaki ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>
            Pizza Snack Play · Panduan Orang Tua
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>05 / 15</Text>
    </Box>
</Slide>
