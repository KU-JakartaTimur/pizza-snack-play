<Slide
    style={{
        width: '1280px',
        height: '720px',
        background: '#FAF7F2',
        paddingTop: 20,
        paddingBottom: 20,
        paddingLeft: 64,
        paddingRight: 64,
    }}
>
    {/* ── A · blok judul ── */}
    <Box style={{ height: 110, justifyContent: 'center' }}>
        <Text
            style={{
                fontSize: 34,
                fontWeight: 'bold',
                color: '#51277C',
                fontFamily: 'Trebuchet MS',
                lineHeight: 1.3,
            }}
        >
            Kabar otomatis lewat WhatsApp
        </Text>
        <Box style={{ marginTop: 10, width: 72, height: 6, borderRadius: 3, background: '#F3B26C' }} />
    </Box>

    {/* ── B · area konten ── */}
    <Box style={{ height: 530, flexDirection: 'row', gap: 30 }}>
        {/* kiri 55% · ilustrasi percakapan WhatsApp */}
        <Box style={{ width: '55%', height: '100%', justifyContent: 'center', alignItems: 'center' }}>
            <svg width={560} height={500} viewBox='0 0 560 500' xmlns='http://www.w3.org/2000/svg'>
                {/* badan ponsel */}
                <rect x='90' y='6' width='380' height='488' rx='30' fill='#FFFFFF' stroke='#E6DFD2' strokeWidth='3' />
                {/* kepala percakapan */}
                <path d='M90 36 a30 30 0 0 1 30 -30 h320 a30 30 0 0 1 30 30 v58 h-380 z' fill='#51277C' />
                <text x='124' y='56' fontFamily='Trebuchet MS' fontSize='19' fontWeight='bold' fill='#FFFFFF'>
                    Pizza Snack Play
                </text>
                <text x='124' y='80' fontFamily='Verdana' fontSize='13' fill='rgba(255,255,255,0.82)'>
                    Kabar untuk wali murid
                </text>

                {/* gelembung 1 · konfirmasi */}
                <rect x='112' y='108' width='336' height='112' rx='16' fill='#FFFFFF' stroke='#E6DFD2' strokeWidth='2' />
                <text x='134' y='140' fontFamily='Verdana' fontSize='14' fill='#6B6478'>
                    Konfirmasi
                </text>
                <text x='134' y='168' fontFamily='Verdana' fontSize='15' fill='#2A2333'>
                    Tanggal Selasa, 1 September
                </text>
                <text x='134' y='192' fontFamily='Verdana' fontSize='15' fill='#2A2333'>
                    sudah tercatat untuk Ani.
                </text>

                {/* gelembung 2 · pengingat */}
                <rect x='112' y='240' width='336' height='136' rx='16' fill='#EEF3D4' stroke='#AFC440' strokeWidth='2' />
                <text x='134' y='272' fontFamily='Verdana' fontSize='14' fill='#5E6B1E'>
                    Pengingat piket
                </text>
                <text x='134' y='300' fontFamily='Verdana' fontSize='15' fill='#2A2333'>
                    Ani bertugas membawa snack
                </text>
                <text x='134' y='324' fontFamily='Verdana' fontSize='15' fill='#2A2333'>
                    pada Selasa, 1 September
                </text>
                <text x='134' y='348' fontFamily='Verdana' fontSize='15' fill='#2A2333'>
                    2026 (Roti Abon + Susu).
                </text>

                {/* keterangan */}
                <text x='112' y='404' fontFamily='Verdana' fontSize='13' fill='#6B6478'>
                    Dikirim otomatis · tidak perlu dibalas
                </text>

                {/* ikon centang */}
                <circle cx='390' cy='452' r='24' fill='#AFC440' />
                <path
                    d='M378 452 l9 10 l17 -20'
                    fill='none'
                    stroke='#FFFFFF'
                    strokeWidth='6'
                    strokeLinecap='round'
                    strokeLinejoin='round'
                />
            </svg>
        </Box>

        {/* kanan 45% · tiga hal yang perlu diketahui */}
        <Box style={{ width: '45%', height: '100%', justifyContent: 'center' }}>
            {[
                {
                    t: 'Begitu tanggal diambil',
                    d: 'Konfirmasi langsung masuk ke WhatsApp wali. Tidak perlu mencatat ulang atau bertanya ke korlas.',
                },
                {
                    t: 'Sehari sebelum piket',
                    d: 'Sekolah mengirim pengingat: nama anak, tanggalnya, dan menu yang perlu dibawa.',
                },
                {
                    t: 'Pastikan nomor Anda terisi',
                    d: 'Kabar dikirim ke nomor di halaman Profil. Kalau belum ada, isi di sana — bisa diubah sendiri.',
                },
            ].map((it, i) => (
                <Box key={i} style={{ marginBottom: i < 2 ? 22 : 0 }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                        <Box style={{ width: 10, height: 10, borderRadius: 5, background: '#F3B26C' }} />
                        <Text
                            style={{
                                fontSize: 21,
                                fontWeight: 'bold',
                                color: '#51277C',
                                fontFamily: 'Trebuchet MS',
                                lineHeight: 1.3,
                            }}
                        >
                            {it.t}
                        </Text>
                    </Box>
                    <Text
                        style={{
                            marginTop: 7,
                            marginLeft: 20,
                            fontSize: 17,
                            color: '#2A2333',
                            fontFamily: 'Verdana',
                            lineHeight: 1.55,
                        }}
                    >
                        {it.d}
                    </Text>
                </Box>
            ))}
        </Box>
    </Box>

    {/* ── C · bilah kaki ── */}
    <Box
        style={{
            height: 40,
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
        }}
    >
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>
            Pizza Snack Play · Panduan Orang Tua
        </Text>
        <Text style={{ fontSize: 14, color: '#6B6478', fontFamily: 'Verdana' }}>12 / 16</Text>
    </Box>
</Slide>
